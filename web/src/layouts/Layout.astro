---
import "../styles/global.css";

import {ClientRouter} from 'astro:transitions';
import HeaderNoBg from "../components/Header_NoBg.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
}

const {title} = Astro.props;
---

<!doctype html>
<html lang="fr">
<head>
    <ClientRouter/>
    <meta charset="UTF-8"/>
    <meta name="description" content="Ce webdocumentaire présente une vaste documentation textuelle, photographique et sonore inédite autour de la mémoire ouvrière du Pays de Montbéliard et de l'ouvrage Mémoires de l'Enclave de Jean-Paul Goux."/>
    <meta name="viewport" content="width=device-width"/>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.PUBLIC_BASE_URL}/favicon.svg`}/>
    <meta name="generator" content={Astro.generator}/>
    <title>{title}</title>
</head>
<body>
<div class="layout">
    <HeaderNoBg/>
    <main>
        <slot/>
    </main>
    <Footer/>
</div>
</body>

<style scoped>
    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background: var(--bg-color);
        overflow-x: hidden;
    }

    .layout {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    main {
        flex-grow: 1;
    }
</style>
</html>
