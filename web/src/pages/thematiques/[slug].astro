---
import Layout from "../../layouts/Layout.astro";
import Carrousel from "../../components/Carrousel.astro";

const { slug } = Astro.params;
const url = new URL(Astro.request.url);
const sectionId = url.searchParams.get("section");

type Section = {
  name: string;
  thematics?: {
    backgroundImage: { url: string };
    title: string;
    slug: string;
    alt: string;
    color: string;
    medias: any[];
  }[];
};

let section: Section | null = null;

try {
  const responseSection = await fetch(
      `${import.meta.env.CMS_URL}/api/sections/${sectionId}`
  );

  if (!responseSection.ok) {
    throw new Error(`HTTP error! status: ${responseSection.status}`);
  }

  section = await responseSection.json();

} catch (error) {
  console.error("Failed to fetch section details", error);
  section = null; // Pour éviter d'accéder à undefined
}

const items = section?.thematics?.map((thematic) => ({
  src: thematic.backgroundImage?.url || "",
  title: thematic.title || "",
  slug: thematic.slug || "",
  alt: thematic.alt || "",
  couleur: thematic.color || "",
  medias: thematic.medias || []
})) || [];
---

<Layout title="Thématiques">
  <div class="container">
  <div class="container2">
    <h1>{section ? section.name : "Section introuvable"}</h1>
    <Carrousel
        items={items}
        positionSlugThematique={slug || ""}
    />
    </div>
  </div>

  <style scoped>

    .container{
      display: flex;
      justify-content: center;
      width: 100vw;

      .container2{
        width: 98vw;
      }
    }

    h1{
      color: #e4e4e4;
      text-align: center;
      font-size: 30px;
      font-family: var(--article-font),Helvetica, serif;
      font-weight: bold;
      margin: 25px 0 25px 0;
    }

    bold {
      color: red;
      font-weight: 800;
      text-transform: uppercase;
    }
  </style>
</Layout>