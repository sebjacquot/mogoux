---
import Layout from "../../layouts/Layout.astro";
import Carrousel from "../../components/Carrousel.astro";
import Return from "../../components/Return.astro";
import {asset} from "../../utils/url";

const { slug } = Astro.params;
const url = new URL(Astro.request.url);
const sectionId = url.searchParams.get("section");

let section: any = null;
let thematics: any[] = [];

try {
  // 1. Récupération de la section
  const responseSection = await fetch(`${import.meta.env.CMS_URL}/api/sections/${sectionId}`);
  if (!responseSection.ok) throw new Error(`HTTP error! status: ${responseSection.status}`);
  section = await responseSection.json();

  // 2. Récupération des IDs des thématiques
  const thematicIds = section.thematics?.map((t: any) => t.id) || [];

  const responseThematics = await fetch(`${import.meta.env.CMS_URL}/api/thematics/by-ids`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ ids: thematicIds }),
  });

  if (!responseThematics.ok) throw new Error(`HTTP error! status: ${responseThematics.status}`);
  const thematicsOfSection = await responseThematics.json();

  // 5. Réindexation des thématiques récupérées par ID
  const thematicsMap = new Map(
      thematicsOfSection.map((t: any) => [t.id, t])
  );

// 6. Reconstruction dans l'ordre de la section
  thematics = thematicIds
      .map((id: string) => {
        const thematic = thematicsMap.get(id);
        if (!thematic) return null;
        return {
          ...thematic,
          color: section?.color || "#000000"
        };
      })
      .filter((t: any) => t !== null);

// 7. Tri dans cet ordre selon le champ `rank`
  thematics.sort((a: any, b: any) => {
    const rankA = a.rank ?? Infinity;
    const rankB = b.rank ?? Infinity;
    return rankA - rankB;
  });

} catch (error) {
  console.error("Failed to fetch section or thematics", error);
  section = null;
  thematics = [];
}

// 7. Construction finale pour le carrousel
const listThematics = thematics.map((thematic: any) => ({
  src: `${import.meta.env.CMS_BASE_URL}${thematic.background_image?.url || ""}`,
  title: thematic.title || "",
  slug: thematic.slug || "",
  alt: thematic.background_image?.alt || "",
  couleur: thematic.color || "",
  documents: thematic.related_documents || []
}));
---

<Layout title="Thématiques">
  <Return linkURL={asset("/thematiques")} linkText = "Retourner aux thématiques" />
  <div class="container">
    <div class="container2">
      <div class="div-titre">
        <h1 style=`background-color: ${section.color}80`> {section ? section.name : "Rubrique introuvable"}</h1>
      </div>
      <Carrousel
          thematics={listThematics}
          positionSlugThematique={slug || ""}
      />
    </div>
  </div>

  <style scoped>
    .container {
      display: flex;
      justify-content: center;
      width: 100vw;
    }

    .container2 {
      width: 98vw;
    }

    .div-titre {
      display: flex;
      justify-content: center;
    }

    h1 {
      color: #ffffff;
      text-align: center;
      font-size: 30px;
      font-family: var(--article-font), Helvetica, serif;
      font-weight: bold;
      margin: 25px 0;
      padding: 0 11px;
      border-radius: 2px;
    }
  </style>
</Layout>