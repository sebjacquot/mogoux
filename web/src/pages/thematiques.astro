---
import Sections from "../components/Sections.astro";
import Layout from "../layouts/Layout.astro";

let sections = [];
try {
  const res = await fetch(`${import.meta.env.CMS_URL}/api/sections/`);
  const data = await res.json();
  sections = data.docs;
} catch (error) {
  console.error("Failed to fetch thematics", error);
}
---

<Layout title="Thématiques">
  <div class="container">
    <div class="intro">
      <h2>Thématiques</h2>
      <p>
        Réalisé sans méthodologie préconçue, l’ensemble des entretiens abordent
        une très grande variété de perspectives, souvent sous la conduite de
        Jean-Paul Goux, parfois spontanément et librement de la part des
        personnes interrogées. Vous pouvez ici sélectionner les principales
        thématiques abordées.
      </p>
    </div>

    <div class="col">
      {
        sections.map((section: any) => (
            <Sections
                title={section.name!}
                thematics={section.thematics}
                sectionId={section.id}
            />
        ))
      }
      <div class="export-archive">
        <p>Exporter les archives au format</p>
        <div class="div-lien-export">
          <a>EAD</a>
          <a>Dublin Core</a>
          <a>CSV</a>
        </div>
      </div>
    </div>
  </div>

  <style scoped>
    .container {
      color: white;
      max-width: 1300px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    @media screen and (min-width: 1600px) {
      main {
        max-width: 1600px;
      }
    }

    .col {
      display: flex;
      flex-direction: column;
      gap: 75px;
    }

    .intro {
      width: 800px;
      margin: 40px auto 100px auto;
      text-align: justify;

      h2 {
        font-size: 60px;
        font-weight: 800;
      }

      p {
        font-size: 17px;
        font-weight: 400;
        line-height: 1.2;
      }
    }

    .export-archive{
      height: 200px;
      display: flex;
      flex-direction: column;
      margin: 20px 20px;

      p{
        text-align: center;
        font-size: 1.5rem;
      }

      .div-lien-export{
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;

        a{
          background-color: var(--navigation);
          color: var(--secondary-color);
          display: inline-block;
          padding: 10px 19px;
          font-size: 1rem;
          width: 85px;
          margin: 0 3%;
          cursor: pointer;
          text-align: center;
          border: none;
          position: relative;
          font-family: var(--titres-font);
          border-radius: 0.25em;
          transition: opacity 0.3s, background-color 0.3s;
        }

        a:hover{
          background-color: #fd6674;
        }
      }
    }

  </style>
</Layout>