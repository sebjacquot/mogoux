---
import Sections from "../components/Sections.astro";
import Layout from "../layouts/Layout.astro";

let sections = [];
let metadataFiles = [];

try {
    const res = await fetch(`${import.meta.env.CMS_URL}/api/sections/`);
    const data = await res.json();

    sections = data.docs.sort((a: any, b: any) => {
        const rankA = a.rank;
        const rankB = b.rank;

        if (rankA == null && rankB == null) return 0;
        if (rankA == null) return 1;
        if (rankB == null) return -1;

        return rankA - rankB;
    });
} catch (error) {
    console.error("Failed to fetch sections", error);
}

try {
    const res = await fetch(`${import.meta.env.CMS_URL}/api/metadata-files/`);
    const data = await res.json();
    metadataFiles = data.docs;
} catch (error) {
    console.error("Failed to fetch metadata files", error);
}
---

<Layout title="Thématiques">
    <div class="container">
        <div class="intro">
            <h2>Thématiques</h2>
            <p>
                Réalisé sans méthodologie préconçue, l’ensemble des entretiens aborde
                une très grande variété de perspectives, souvent sous la conduite de
                Jean-Paul Goux, parfois spontanément et librement de la part des
                personnes interrogées. Vous pouvez ici sélectionner les principales
                thématiques abordées et classées par rubrique.
            </p>
        </div>

        <div class="col">
            {sections.map((section: any) => (
                    <Sections
                        title={section.name!}
                        sectionId={section.id}
                        color={section.color}
                        thematics={section.thematics}
                    />
                ))}
            {metadataFiles.length > 0 && (
                <div class="export-archive">
                    <p>Exporter l'instrument de recherche</p>
                    <div class="div-lien-export">
                        {metadataFiles.map((file: any) => (
                            <a href=`${import.meta.env.CMS_BASE_URL}${file.url}`>{file.standard_name}</a>
                        ))}
                    </div>
                </div>
            )}
        </div>
    </div>

    <style scoped>
        .container {
            color: white;
            max-width: 1300px;
            margin: 0 auto;
            padding: 0 1rem;
        }

        @media screen and (min-width: 1600px) {
            main {
                max-width: 1600px;
            }
        }

        .col {
            display: flex;
            flex-direction: column;
            gap: 75px;
        }

        .intro {
            width: 800px;
            margin: 40px auto 100px auto;
            text-align: justify;

            h2 {
                font-size: 60px;
                font-weight: 800;
            }

            p {
                font-size: 17px;
                font-weight: 400;
                line-height: 1.2;
            }
        }

        .export-archive {
            height: 200px;
            display: flex;
            flex-direction: column;
            margin: 20px 20px;

            p {
                text-align: center;
                font-size: 1.5rem;
            }

            .div-lien-export {
                width: 100%;
                height: 100%;
                display: flex;
                justify-content: center;
                align-items: center;

                a {
                    background-color: var(--navigation);
                    color: var(--secondary-color);
                    display: inline-block;
                    padding: 10px 19px;
                    font-size: 1rem;
                    width: 85px;
                    margin: 0 3%;
                    cursor: pointer;
                    text-align: center;
                    border: none;
                    position: relative;
                    font-family: var(--titres-font);
                    border-radius: 0.25em;
                    transition: opacity 0.3s, background-color 0.3s;
                  text-decoration: none;
                }

                a:hover {
                    background-color: #fd6674;
                }
            }
        }

    </style>
</Layout>