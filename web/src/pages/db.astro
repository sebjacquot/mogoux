---
import Bloc1 from "../components/Blocs/Bloc1.astro";
import Bloc2 from "../components/Blocs/Bloc2.astro";
import Bloc3 from "../components/Blocs/Bloc3.astro";
import Bloc4 from "../components/Blocs/Bloc4.astro";
import Bloc5 from "../components/Blocs/Bloc5.astro";
import Bloc6 from "../components/Blocs/Bloc6.astro";

import type { Media } from "../../../cms/src/generated-types.ts";

let medias: { type: "image" | "audio" | "video"; src: string; slug: string }[] =
  [];
try {
  const res = await fetch(`${import.meta.env.CMS_URL}/api/medias/`);
  const data = await res.json();
  medias = (data.docs as Media[]).map((media) => ({
    type: media.type,
    src: `${import.meta.env.CMS_URL}${media.url}`,
    slug: media.slug,
  }));
} catch (error) {
  console.error("Failed to fetch thematics", error);
}

const blocs = [
  {
    component: Bloc1,
    tile: 5,
  },
  {
    component: Bloc2,
    tile: 3,
  },
  { component: Bloc3, tile: 5 },
  { component: Bloc4, tile: 6 },
  { component: Bloc5, tile: 3 },
  { component: Bloc6, tile: 6 },
];

const shuffle = (items: any[]) => {
  return items.sort(() => Math.random() - 0.5);
};

// const res = await fetch(
//   "https://api.slingacademy.com/v1/sample-data/photos?limit=126"
// );
// const data = await res.json();

shuffle(medias);

let results: any[] = [];
let blocIndex = 0;

for (let i = 1; i <= medias.length; i++) {
  const { component, tile } = blocs[blocIndex];

  results.push({
    id: blocIndex,
    component,
    medias: medias.slice(i - 1, i - 1 + tile),
  });

  if (blocIndex >= blocs.length - 1) {
    blocIndex = 0;
  } else {
    blocIndex++;
  }

  i += tile - 1;
}

shuffle(results);
---

<html>
  <main>
    {results.map(({ component: Bloc, medias }) => <Bloc medias={medias} />)}
  </main>

  <style scoped>
    /* main {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 4px;
  }
  main > * {
    flex: 1 1 calc(20% - 4px); 
    box-sizing: border-box; 
  } */

    main {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(330px, 100%), 1fr));
      /* gap: 4px; */
      column-gap: 4px;
    }
    body {
      background: #1f1f1f;
    }
  </style>


</html>
