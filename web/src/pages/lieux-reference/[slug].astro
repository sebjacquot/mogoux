---
import Galerie from "../../components/Galerie.astro";
import Layout from "../../layouts/Layout.astro";
import ImageTooltip from "../../components/ImageTooltip.astro";
import { renderLexicalToHTML } from '../../utils/renderLexical';
import Return from "../../components/Return.astro";
import {asset} from "../../utils/url";

const {slug} = Astro.params;

let referenceLocations = null;

try {
    const res = await fetch(`${import.meta.env.CMS_URL}/api/reference-locations/slug/${slug}`);
    referenceLocations = await res.json();
} catch (error) {
    console.error("Failed to fetch reference locations", error);
}

let sections = null;
try {
    const res = await fetch(`${import.meta.env.CMS_URL}/api/sections`);
    const json = await res.json();
    sections = json.docs ?? [];
} catch (error) {
    console.error("Failed to fetch sections", error);
}

const documents = await Promise.all(
    referenceLocations?.related_documents?.map(async (document: any) => {
        if (!document) return null;

        // Prévisualisation audio/vidéo
        const previewAudioVideoUrl =
            document.preview_audio_video?.sizes?.preview?.url
                ? `${import.meta.env.CMS_BASE_URL}${document.preview_audio_video.sizes.preview.url}`
                : document.preview_audio_video?.url
                ? `${import.meta.env.CMS_BASE_URL}${document.preview_audio_video.url}`
                : null;

        // Image source principale
        const src =
            document.sizes?.preview?.url
                ? `${import.meta.env.CMS_BASE_URL}${document.sizes.preview.url}`
                : document.url
                ? `${import.meta.env.CMS_BASE_URL}${document.url}`
                : null;

        if (!src) return null;

        return {
            type: document.type ?? '',
            src,
            alt: document.alt ?? '',
            slug: document.slug ?? '',
            titre: document.title ?? '',
            section: document.thematics?.[0]?.related_sections?.docs ?? '',
            preview_audio_video: previewAudioVideoUrl,
        };
    }) ?? []
);

const descriptionHtml = referenceLocations?.description?.root?.children
    ? renderLexicalToHTML(referenceLocations.description.root.children)
    : "";

const quoteHtml = referenceLocations?.quote?.root?.children
    ? renderLexicalToHTML(referenceLocations.quote.root.children)
    : "";

const legendeHtml = referenceLocations?.background_image?.legende?.root?.children
    ? renderLexicalToHTML(referenceLocations?.background_image?.legende?.root?.children)
    : ""
---

<Layout title=`${referenceLocations.name}`>
    <Return linkURL={asset("/carte")} linkText = "Retourner à la carte" />
    <section class="entete">
        <div class="hero">
            <h2 class="tag">Lieu</h2>
            <h1 class="titre">{referenceLocations.name}</h1>
            <div class="intro">
                <div class="text-container">
                    <div class="text-wrapper">
                        <div class="text-slide" set:html={descriptionHtml}></div>
                        <div class="text-slide" set:html={quoteHtml}></div>
                    </div>
                </div>
                <div class="div-toggle-button">
                    <button id="toggle-button">Citation des <i>Mémoires de l'Enclave</i></button>
                </div>
                <div class="separation">
                    <div class="background"></div>
                </div>
            </div>
        </div>

        {referenceLocations?.background_image && (
            <ImageTooltip
                src={`${import.meta.env.CMS_BASE_URL}${referenceLocations.background_image.url}`}
                legend={legendeHtml}
                alt={legendeHtml}
            />
        )}

        <div class="overlay"></div>
    </section>

    <section class="content">
        <div class="frise grid-wrapper">
            <Galerie documents={documents} sections={sections} />
        </div>

    </section>

    <script is:inline>
        document.addEventListener("astro:after-swap", initializePage);
        document.addEventListener("astro:page-load", initializePage);

        function initializePage() {
            alignLastParagraphToCitation();
            setupTextToggle();
        }

        function setupTextToggle() {
            const textContainer = document.querySelector(".text-container");
            const textWrapper = document.querySelector(".text-wrapper");
            const paragraphs = document.querySelectorAll(".text-slide");
            const button = document.getElementById("toggle-button");

            if (!textContainer || !textWrapper || paragraphs.length < 2 || !button) return;

            let showingFirstText = true;

            function updateSize(adjustBefore) {
                const activeText = paragraphs[showingFirstText ? 0 : 1];

                if (adjustBefore) {
                    textContainer.style.height = `${activeText.scrollHeight}px`;
                }

                setTimeout(() => {
                    textWrapper.style.transform = showingFirstText ? "translateX(0%)" : `translateX(-${paragraphs[0].offsetWidth}px)`;

                    if (!adjustBefore) {
                        setTimeout(() => {
                            textContainer.style.height = `${activeText.scrollHeight}px`;
                        }, 500);
                    }
                }, adjustBefore ? 300 : 0);
            }

            button.addEventListener("click", () => {
                const activeText = paragraphs[showingFirstText ? 0 : 1];
                const currentHeight = textContainer.offsetHeight;
                const nextHeight = activeText.scrollHeight;

                const adjustBefore = nextHeight > currentHeight;

                showingFirstText = !showingFirstText;
                updateSize(adjustBefore);

                button.innerHTML = showingFirstText
                    ? "Citation des <i>Mémoires de l'Enclave</i>"
                    : "Retour à la description";
            });

            textContainer.style.height = `${paragraphs[0].scrollHeight}px`;
        }

        function alignLastParagraphToCitation() {
            const secondParagraphContainer = document.querySelector(".text-slide:last-of-type");

            if (!secondParagraphContainer) return;

            const paragraphs = secondParagraphContainer.querySelectorAll("p");
            const lastParagraph = paragraphs[paragraphs.length - 1];

            if (lastParagraph) {
                lastParagraph.style.textAlign = "end";
            }
        }
    </script>

    <style scoped>

        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 2;
            pointer-events: none;
        }

        .entete {
            position: relative;
            width: 100%;
            height: 75vh;
            max-height: 700px;
            min-height: 560px;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        .hero {
            display: flex;
            flex-direction: column;
            align-items: start;
            padding: 0 100px 40px 100px;
            position: absolute;
            width: calc(100% - 200px);
            bottom: 0;
            left: 0;
            gap: 20px;
            color: white;
            z-index: 5;
            pointer-events: none;
            overflow: hidden;

            h1 {
                color: white;
                font-size: 3em;
                text-align: start;
                pointer-events: auto;
            }

            .tag {
                font-size: 50px;
                font-family: "Merryweather", sans-serif;
                font-style: italic;
                font-weight: 300;
                border-bottom: 1px solid white;
                line-height: 65px;
                width: fit-content;
                pointer-events: auto;
            }

            .titre {
                font-size: 60px;
                font-family: var(--article-font);
                font-weight: bold;
                line-height: 65px;
            }

            .intro {
                color: var(--secondary-color);
                width: 100%;
                margin-top: 5vh;
                text-align: justify;
                pointer-events: none;
            }
        }

        .div-toggle-button{
            display: flex;
            justify-content: end;
            margin-top: 20px;
            pointer-events: none;
        }

        #toggle-button{
            pointer-events: auto;
            cursor: pointer;
            display: inline-block;
            background-color: #cccccc1a;
            border: none;
            color: var(--secondary-color);
            font-family: var(--titres-font);
            font-weight: 800;
            font-size: 13px;
            line-height: 2.9;
            padding: 0 1.25em;
            border-radius: 0.25em;
            transition: opacity 0.3s, background-color 0.3s;
        }

        #toggle-button:hover{
            background-color: #cccccc33;
        }

        .text-container {
            width: 100%;
            overflow: hidden;
            transition: height 0.5s ease-in-out;
            pointer-events: none;
        }

        .text-wrapper {
            display: flex;
            width: auto;
            transition: transform 0.5s ease-in-out;
        }

        .text-slide {
            width: 100%;
            height: min-content;
            flex: 0 0 auto;
            margin: 0;
            padding: 0;
            white-space: normal;
            pointer-events: auto;
            text-align: justify;
            display: flex;
            flex-direction: column;

            .citation-source {
                text-align: end;
                font-size: 0.9rem;
            }
        }

        .content {
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 50px;
            width: 97.5vw;
            margin: 15px auto 0 auto;
        }

        .index {
            display: flex;
            justify-content: center;
            align-items: center;
            position: absolute;
            gap: 20px;
            top: 20px;
            left: 30px;
            height: 20px;
            z-index: 2;
        }

    </style>
</Layout>
