---
import Details from "../../components/Details.astro";
import Layout from "../../layouts/Layout.astro";
import Return from "../../components/Return.astro";
import {asset} from "../../utils/url";

const { slug } = Astro.params;

let detail: any = [];
try {
    const res = await fetch(`${import.meta.env.CMS_URL}/api/medias/slug/${slug}`);
    const data = await res.json();
    detail = data;
} catch (error) {
    console.error("Failed to fetch medias details", error);
}
const tags = detail.identification.tag.map((tag: any) => tag.tag_name);

const queryParams = new URLSearchParams(Astro.url.search);
const slugsString = queryParams.get("slugs") || "";
const fromURL = queryParams.get("from") || "";

const mediasList = slugsString ? slugsString.split("%2C") : [];
const currentIndex = mediasList.indexOf(slug || "");
const previousSlug = currentIndex > 0 ? mediasList[currentIndex - 1] : "";
const nextSlug = currentIndex < mediasList.length - 1 ? mediasList[currentIndex + 1] : "";

---

<Layout title="Medias">
    <Return fromURL={fromURL} />
    <div class='container'>
        <nav>
            {previousSlug && (
                    <a href={asset(`/medias/${previousSlug}?slugs=${encodeURIComponent(slugsString)}&from=${encodeURIComponent(fromURL)}`)} class="prev">
                        &#10094;
                    </a>
            )}

            {nextSlug && (
                    <a href={asset(`/medias/${nextSlug}?slugs=${encodeURIComponent(slugsString)}&from=${encodeURIComponent(fromURL)}`)} class="next">
                        &#10095;
                    </a>
            )}
        </nav>
        <Details
                titre={detail.identification.title}
                date={detail.identification.date}
                description={detail.description}
                lieu_name={detail.location.location_name}
                lieu_link={detail.location.location_link}
                credits_name={detail.contexte.credits_name}
                credits_link={detail.contexte.credits_link}
                tags={tags}
                type={detail.type}
                link_notice={detail.notice}
                src={detail.filename}
                alt={detail.alt}
        />
    </div>

    <style>
        .container {
            position: relative;
            min-height: 100vh;
            width: 100%;
            display: flex;
            flex-direction: column;
        }
        a {
            position: absolute;
            top: 50%;
            color: white;
            text-decoration: none;
            font-size: 2rem;
            transition: transform 0.3s ease-in-out, color 0.3s ease-in-out;
        }
        a:hover {
            text-decoration: none;
            color: #c5c5c5;
            transform: scale(1.2);
        }

        .prev{
            left: 30px;
        }

        .next{
            right: 30px;
        }
    </style>
</Layout>