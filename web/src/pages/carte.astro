---
import Layout from "../layouts/Layout.astro";
import {asset} from "../utils/url";
---

<Layout title="Carte">
    <div class="map-container">
        <img src={asset("/Nouvelle-carte.jpeg")} alt="Carte" class="carte" id="img-original" loading="lazy" />
        <p class="source-carte">IGN-Scan 50® Historique 1950</p>

        <div id="img-zoom" class="img-zoom-result"  style={`background-image: url(${asset('/Nouvelle-carte.jpeg')})`}></div>
        <div class="pins">
            <a href={asset("/villes/hericourt")}>
                <img src={asset("/icones/pin.png")} alt="Pin Héricourt" class="pin" style="top: 5%; left: 36%;" />
                <div class="tooltip" style="top: 7%; left: 36%;">Héricourt, lieu marqué par l’usine de tissage de la Grand-Pré, active de la fin du XIXe siècle jusqu’à la fin du XXe siècle</div>
            </a>
            <a href={asset("/villes/bethoncourt")} >
                <img src={asset("/icones/pin.png")} alt="Pin Bethoncourt" class="pin" style="top: 34.5%; left: 45%;" />
                <div class="tooltip" style="top: 36.5%; left: 47%;">Bethoncourt, site industriel important autour de la filature de la Lizaine</div>
            </a>
            <a href={asset("/villes/montbeliard")} >
                <img src={asset("/icones/pin.png")} alt="Pin Montbéliard" class="pin" style="top: 49%; left: 47%;" />
                <div class="tooltip" style="top: 51%; left: 47%;">Montbéliard, ville historique majeure et centre du pouvoir du Comté puis de la Principauté de Montbéliard</div>
            </a>
            <a href={asset("/villes/sochaux")}>
                <img src={asset("/icones/pin.png")} alt="Pin Sochaux" class="pin" style="top: 46%; left: 51%;" />
                <div class="tooltip" style="top: 48%; left: 51%;">Sochaux est devenu le lieu emblématique de l’entreprise Peugeot au XXe siècle</div>
            </a>
            <a href={asset("/villes/fesches-le-chatel-dampierre")} >
                <img src={asset("/icones/pin.png")} alt="Pin Fesches-le-Châtel" class="pin" style="top: 43%; left: 77%;" />
                <div class="tooltip" style="top: 45%; left: 77%;">Fesches-le-Châtel, site industriel de la vallée de la Feschotte, lié à l’entreprise Japy</div>
            </a>
            <a href={asset("/villes/bart-bavans")}>
                <img src={asset("/icones/pin.png")} alt="Pin Bart-Bavans" class="pin" style="top: 66%; left: 37%;" />
                <div class="tooltip" style="top: 68%; left: 37%;">Bart-Bavans, site métallurgique de la Roche (ou Laroche)</div>
            </a>
            <a href={asset("/villes/audincourt")} >
                <img src={asset("/icones/pin.png")} alt="Pin Audincourt" class="pin" style="top: 68%; left: 55%;" />
                <div class="tooltip" style="top: 70%; left: 55%;">Audincourt, forges et fonderies d’Audincourt, haut-lieu industriel depuis la fin du XVIIIe siècle</div>
            </a>
            <a href={asset("/villes/beaucourt")}>
                <img src={asset("/icones/pin.png")} alt="Pin Beaucourt" class="pin" style="top: 64%; left: 79%;" />
                <div class="tooltip" style="top: 66%; left: 79%;">Beaucourt, lieu emblématique de l’entreprise Japy.</div>
            </a>
            <a href={asset("/villes/beaulieu-valentigney")} >
                <img src={asset("/icones/pin.png")} alt="Pin Beaulieu-Valentigney" class="pin" style="top: 87%; left: 55%;" />
                <div class="tooltip" style="top: 81%; left: 44.5%;">Site industriel majeur situé entre Valentigney et Mandeure, lié à l’entreprise Peugeot depuis la première moitié du XIXe siècle</div>
            </a>
            <a href={asset("/villes/herimoncourt")} >
                <img src={asset("/icones/pin.png")} alt="Pin Hérimoncourt" class="pin" style="top: 88%; left: 67%;" />
                <div class="tooltip" style="top: 83%; left: 78%;">Hérimoncourt, lieu industriel historique majeur et berceau de la famille Peugeot</div>
            </a>
        </div>
    </div>

    <script is:inline>
        function cleanUpPreviousInstances() {
            const map = document.querySelector("#img-original");
            if (map) {
                const newMap = map.cloneNode(true);
                map.replaceWith(newMap);
            }

            document.querySelectorAll(".pins a").forEach((link) => {
                const newLink = link.cloneNode(true);
                link.replaceWith(newLink);
            });
        }

        function setupZoomAndTooltips() {

            cleanUpPreviousInstances();

            const map = document.querySelector("#img-original");
            const mapZoom = document.querySelector("#img-zoom");

            if (map && mapZoom) {
                const zoom = (event) => {
                    const zoomer = event.currentTarget ;
                    if (!zoomer) return;

                    let offsetX;
                    let offsetY;

                    if ("touches" in event) {
                        offsetX = event.touches[0]?.pageX;
                        offsetY = event.touches[0]?.pageY;
                    } else {
                        offsetX = (event ).offsetX;
                        offsetY = (event ).offsetY;
                    }

                    if (offsetX !== undefined && offsetY !== undefined) {
                        const x = (offsetX / zoomer.offsetWidth) * 100;
                        const y = (offsetY / zoomer.offsetHeight) * 100;
                        mapZoom.style.backgroundPosition = `${x}% ${y}%`;
                    }
                };

                map.addEventListener("mousemove", zoom);
            }

            const links = document.querySelectorAll(".pins a");
            links.forEach((link) => {
                const tooltip = link.querySelector(".tooltip");

                if (tooltip) {
                    link.addEventListener("mouseenter", () => {
                        tooltip.style.display = "block";
                        tooltip.style.opacity = "1";
                    });

                    link.addEventListener("mouseleave", () => {
                        tooltip.style.opacity = "0";
                        setTimeout(() => {
                            tooltip.style.display = "none";
                        }, 200);
                    });
                }
            });

        }

        document.addEventListener("astro:page-load", setupZoomAndTooltips);
        document.addEventListener("astro:after-swap", setupZoomAndTooltips);
    </script>

    <style scoped>
        body, html {
            height: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
            overflow: auto;
        }

        .map-container {
            position: relative;
            width: 90%;
            margin: 0 5%;

        }

        .carte {
            width: 100%;
            height: auto;
            display: block;
        }

        .source-carte{
            position: absolute;
            bottom: 10px;
            left: 10px;
            background-color: rgba(228, 228, 228, 0.66);
            border-radius: 3px;
            padding: 3px;
            font-size: 0.8rem;
        }

        .img-zoom-result {
            background-position: 50% 50%;
            background-repeat: no-repeat;
            position: absolute;
            border: 4px solid var(--legende-color);
            border-radius: 3px;
            width: 30vw;
            height: 20vw;
            background-size: 900%;
            top: 0.5vw;
            right: 0.5vw;
            z-index: 10;
        }

        .pins {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;

            a{
                pointer-events: auto;
            }
        }

        .pin {
            position: absolute;
            width: 40px;
            height: 40px;
            transform: translate(-50%, -50%);
        }

        .tooltip {
            position: absolute;
            background-color: rgba(0, 0, 0, 0.75);
            color: #fff;
            padding: 6px 10px;
            border-radius: 4px;
            font-size: 14px;
            white-space: normal;
            pointer-events: none;
            display: none;
            z-index: 1000;
            transform: translateX(-50%);
            transition: opacity 0.2s ease-in-out;
            max-width: 200px;
            word-wrap: break-word;
            text-align: center;
        }

        @media (max-width: 768px) {
            .pin {
                width: 30px;
                height: 30px;
            }
        }
    </style>
</Layout>