  <style scoped>
    .img-zoom-result {
      background-image: url("/Carte_test.jpg");
      background-position: 50% 50%;
      background-repeat: no-repeat;
      position: absolute;
      border: 5px solid #242424;
      width: 300px;
      height: 300px;
      background-size: 1200%;
      top: 20px;
      right: 20px;
      z-index: 10;
    }
    .img-zoom-lens {
      position: absolute;
      background: rgba(29, 25, 25, 0.5);
      border: 1px solid #383838;
      width: 40px;
      height: 40px;
      z-index: 10;
      top: 0;
      left: 0;
    }
    body,
    html,
    main {
      height: 100%;
      width: 100%;
      margin: 0;
      padding: 0;
      overflow: hidden;
      position: relative;
    }
    .carte {
      height: 100%;
      width: 100%;
      z-index: 1;
    }

    .pin {
