    <div id="img-zoom" class="img-zoom-result"></div>
    <!-- <div id="img-zoom-lens" class="img-zoom-lens"></div> -->

    <a
      href="/villes/hericourt"
      title="Lieu marqué par l’usine de tissage de la Grand-Pré, active de la fin du XIXe siècle jusqu’à la fin du XXe siècle"
      ><img src="/pin.png" alt="pin" class="pin1 pin" /></a
    >
    <a
      href="/villes/bethoncourt"
      title="Site industriel important autour de la filature de la Lizaine"
      ><img src="/pin.png" alt="pin" class="pin2 pin" /></a
    >
    <a
      href="/villes/montbeliard"
      title="Ville historique majeure et centre du pouvoir du Comté puis de la Principauté de Montbéliard"
