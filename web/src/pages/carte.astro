      ><img src="/pin.png" alt="pin" class="pin5 pin" /></a
    >
    <a
      href="/villes/audincourt"
      title="Forges et fonderies d’Audincourt, haut-lieu industriel depuis la fin du XVIIIe siècle"
      ><img src="/pin.png" alt="pin" class="pin6 pin" /></a
    >
    <a
      href="/villes/fesches-le-chatel-dampierre"
      title="Site industriel de la vallée de la Feschotte, lié à l’entreprise Japy"
      ><img src="/pin.png" alt="pin" class="pin7 pin" /></a
    >
    <a href="/villes/beaucourt" title="Lieu emblématique de l’entreprise Japy."
      ><img src="/pin.png" alt="pin" class="pin8 pin" /></a
    >
    <a
      href="/villes/bart-bavans"
      title="Site métallurgique de la Roche (ou Laroche)"
      ><img src="/pin.png" alt="pin" class="pin9 pin" /></a
    >
    <a
      href="/villes/sochaux"
      title="Sochaux est devenu le lieu emblématique de l’entreprise Peugeot au XXe siècle"
      ><img src="/pin.png" alt="pin" class="pin10 pin" /></a
    >
