    @import url("https://fonts.cdnfonts.com/css/helvetica-neue-5");
    * {
      box-sizing: border-box;
    }
    html,
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      background: var(--bg-article-color);
      position: relative;

      overflow-x: hidden;
    }
    strong {
      font-weight: bold;
    }
    i {
