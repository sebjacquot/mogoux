      max-width: 1100px;
      margin: 0 auto;

      font-size: 13px;

      h3 {
        font-size: 20px;
        line-height: 30px;
        font-weight: 300;
        font-family: var(--article-intro-font);
        font-style: italic;

        margin-bottom: 10px;
      }
    }

    .suggestions-tag {
      font-family: var(--article-intro-font);
      font-size: 27px;
      font-weight: 300;
      font-style: italic;

      display: flex;
      justify-content: center;
      color: #8d8d8d;

      h4::after {
        content: "";
        display: block;
        border: 1px solid #e4e4e4;
        background: #e4e4e4;

        height: 50px;
        width: 1px;
        margin: 10px auto 0px auto;
      }
    }

    .suggestions {
      display: flex;
      justify-content: center;
      align-items: center;

      height: 220px;

      gap: 20px;

      background: #e4e4e4;

      padding-top: 10px;
      padding-bottom: 10px;
    }

    .card {
      width: 300px;
      height: 180px;
      overflow: hidden;
      border-radius: 2px;
      position: relative;

      h3 {
        font-size: 16px;
        line-height: 18px;
        font-family: var(--article-font); /* Helvetica */
        font-weight: 600;

        padding: 0 20px;

        text-align: center;

        color: white;
        position: absolute;
        bottom: 10px;
        left: 0;
        z-index: 20;
      }
      img {
        max-width: 100%;
        max-height: 100%;
        transition: transform 0.3s ease;
        position: relative;
        scale: 1.2;
        z-index: 1;
      }
      .overlay2 {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.3);
        position: absolute;
        top: 0;
        left: 0;
        z-index: 5;
      }
