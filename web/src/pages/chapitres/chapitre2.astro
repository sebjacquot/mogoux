      content: "";
      display: block;
      border: 1px solid #e4e4e4;
      background: #e4e4e4;

      height: 50px;
      width: 1px;
      margin: 10px auto 0px auto;
    }
  }

  .suggestions {
    display: flex;
    justify-content: center;
    align-items: center;

    height: 220px;

    gap: 20px;

    background: #e4e4e4;

    padding-top: 10px;
    padding-bottom: 10px;
  }

  .card {
    width: 300px;
    height: 180px;
    overflow: hidden;
    border-radius: 2px;
    position: relative;

