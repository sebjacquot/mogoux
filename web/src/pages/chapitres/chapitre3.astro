      width: 100%;
      height: 75vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
    }
    .rectangle {
      background: #242424;
      width: 100vw;
      height: 80px;
      position: fixed;
      z-index: 1000;
      top: 0;
      left: 0;
    }
    .img-cover {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 75vh;
      object-fit: cover;
      object-position: 0 41%;
      z-index: 1;
    }

    .overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 75vh;
      background: rgba(0, 0, 0, 0.4);
      z-index: 2;
    }
    main {
      position: relative;
      width: 100%;

      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .hero {
      background-image: url("img/kenloach.jpg");
      font-family: "Graphik", sans-serif;
      height: 75vh;
      /* margin-top: 150px; */
      z-index: 100;

      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: center;

      .tag {
        font-weight: bold;
        color: var(--secondary-color);
        font-size: 12px !important;
        line-height: 19.2px;
        text-transform: uppercase;
        padding: 1px 10px 1px 10px;
        border-radius: 4px;
        margin-bottom: 30px;

        background-color: #e72465;
      }

      .titre {
        font-weight: bold;
        color: var(--secondary-color);
        font-size: 60px !important;
        line-height: 60px !important;
        text-align: center;
        /* margin-bottom: 5px; */
      }
      .soustitre {
        font-weight: bold;
        color: var(--secondary-color);
        font-size: 30px !important;
        font-weight: 300;
      }
      .soustitre::before {
        content: "";
        display: block;
        border-left: 1px solid #d9d9d9;
        height: 50px;
        width: 1px;
        margin: 20px auto 5px auto;
      }
    }
  </style>
</html>
