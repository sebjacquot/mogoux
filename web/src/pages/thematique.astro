---
// @ts-nocheck

import Sections from "../components/Sections.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";
import { Image } from "astro:assets";

// @ts-ignore
import type {
  Section,
  Thematic,
  Document,
} from "../../../cms/src/generated-types.ts";

let sections: Section[] = [];
try {
  const res = await fetch(`${import.meta.env.CMS_URL}/api/sections/`);
  const data = await res.json();
  sections = data.docs;
} catch (error) {
  console.error("Failed to fetch thematics", error);
}
---

<head>
  <meta charset="UTF-8" />
</head>

<html>
  <main>
    <Header />
    <div class="intro">
      <h2>Aller plus loin</h2>
      <p>
        Réalisé sans méthodologie préconçue, l’ensemble des entretiens abordent
        une très grande variété de perspectives, souvent sous la conduite de
        Jean-Paul Goux, parfois spontanément et librement de la part des
        personnes interrogées. Vous pouvez ici sélectionner les principales
        thématiques abordées.
      </p>
    </div>

    <div class="col">
      {
        sections.map((section) => (
          <Sections
            title={section.name!}
            files={(section.documents?.[0] as Document).filename!}
            thematics={section.thematics as Thematic[]}
          />
        ))
      }
    </div>
  </main>
</html>

<style scoped>
  html {
    font-family: var(--titres-font);
    background-color: var(--bg-color);
  }
  main {
    /* margin: 50px 0; */
    color: white;
    max-width: 1300px; /* gros écran = 1600px */
    margin: 0 auto;
  }
  @media screen and (min-width: 1600px) {
    main {
      max-width: 1600px;
    }
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 75px;
  }

  .intro {
    width: 800px;
    margin: 40px auto 100px auto;
    text-align: center;

    h2 {
      font-size: 60px;
      font-weight: 800;
    }
    p {
      font-size: 17px;
      font-weight: 400;
      line-height: 1.2;
    }
  }

  h3 {
    font-size: 20px;
    font-weight: 700;
  }
</style>
