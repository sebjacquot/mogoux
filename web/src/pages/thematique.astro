---
import CardMedias from "../components/CardMedias.astro";
import ThematiqueCard from "../components/ThematiqueCard.astro";
import "../styles/global.css";
import { Image } from "astro:assets";

let thematics = [];
try {
  const res = await fetch("http://localhost:3000/api/thematics/");
  const data = await res.json();
  thematics = data.docs || [];
} catch (error) {
  console.error("Failed to fetch thematics", error);
}
---

<head>
  <meta charset="UTF-8" />
</head>

<html>
  <main>
    <!-- <pre>{JSON.stringify(thematics,null,2)}</pre> -->

    <div class="intro">
      <h2>Aller plus loin</h2>
      <p>
        Réalisé sans méthodologie préconçue, l’ensemble des entretiens abordent
        une très grande variété de perspectives, souvent sous la conduite de
        Jean-Paul Goux, parfois spontanément et librement de la part des
        personnes interrogées. Vous pouvez ici sélectionner les principales
        thématiques abordées.
      </p>
    </div>

    <section class="thematique">
      <div class="row">
        <h2 class="titre">
          Un titre vraiment très classique qui parle de tout et de rien
        </h2>
        <button>Télécharger</button>
      </div>
      <hr />
      <div class="thematique-inner">
        {
          thematics.length > 0 ? (
            thematics.map((thematic: any) => (
              <ThematiqueCard
                src={thematic.backgroundImage.url}
                titre={thematic.title}
                slug={thematic.slug}
                alt={thematic.alt}
              />
            ))
          ) : (
            <p>No thematics available</p>
          )
        }
      </div>
    </section>
  </main>
</html>

<style scoped>
  html {
    font-family: var(--titres-font);
    background-color: var(--bg-color);
  }
  main {
    margin: 50px 0;

    color: white;
  }
  hr {
    width: 86%;
    border: 0;
    height: 2px;
    background-color: rgba(255, 255, 255, 0.1);
    margin-bottom: 13px;
  }

  .row {
    display: flex;
    align-self: flex-start;
  }
  .titre {
    align-self: flex-start;
    color: var(--secondary-color);
    font-size: 20px;
    margin-left: 7vw;
    margin-bottom: 0px;
  }

  .intro {
    width: 800px;
    margin: 0 auto;
    text-align: center;

    h2 {
      font-size: 60px;
      font-weight: 800;
    }
    p {
      font-size: 17px;
      font-weight: 400;
      line-height: 1.2;
    }
  }

  .thematique {
    display: flex;
    flex-direction: column;

    align-items: center;
    margin: 50px auto 0 auto;
  }
  .thematique-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 70px;
    column-gap: 40px;
    max-width: 90vw;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .card:hover {
    h3 {
      color: #ff7979;
    }
  }

  .rectangle {
    width: 300px;
    height: 200px;
    background-image: url("https://source.unsplash.com/random");
    background-size: cover;
    background-position: center;
  }

  .card:hover .rectangle::after {
    content: "";
    display: block;
    width: 100%;
    height: 100%;
    background: rgba(255, 121, 121, 0.502);
  }

  h3 {
    font-size: 20px;
    font-weight: 700;
  }
</style>
