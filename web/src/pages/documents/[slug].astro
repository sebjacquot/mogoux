---
import Details from "../../components/Details.astro";
import Layout from "../../layouts/Layout.astro";
import Return from "../../components/Return.astro";
import {asset} from "../../utils/url";

const { slug } = Astro.params;

let documents: any = [];
try {
    const res = await fetch(`${import.meta.env.CMS_URL}/api/documents/slug/${slug}`);
    documents = await res.json();
} catch (error) {
    console.error("Failed to fetch documents details", error);
}

const queryParams = new URLSearchParams(Astro.url.search);
const slugsString = queryParams.get("slugs") || "";
const fromURL = queryParams.get("from") || "";

const mediasList = slugsString ? slugsString.split("%2C") : [];
const currentIndex = mediasList.indexOf(slug || "");
const previousSlug = currentIndex > 0 ? mediasList[currentIndex - 1] : "";
const nextSlug = currentIndex < mediasList.length - 1 ? mediasList[currentIndex + 1] : "";

---

<Layout title="Documents">
    <Return linkURL={fromURL} />
    <div class='container'>
        <nav>
            {previousSlug && (
                    <a href={asset(`/documents/${previousSlug}?slugs=${encodeURIComponent(slugsString)}&from=${encodeURIComponent(fromURL)}`)} class="prev">
                        &#10094;
                    </a>
            )}

            {nextSlug && (
                    <a href={asset(`/documents/${nextSlug}?slugs=${encodeURIComponent(slugsString)}&from=${encodeURIComponent(fromURL)}`)} class="next">
                        &#10095;
                    </a>
            )}
        </nav>
        <Details
                title={documents.title}
                date={documents.date}
                description={documents.description}
                location={documents.location}
                credits_name={documents.credits_name}
                credits_link={documents.credits_link}
                tags={documents.physical_characteristics}
                type={documents.type}
                link_notice={documents.notice}
                src={documents.url}
                legend={documents.legend}
                alt={documents.alt}
                preview_audio_video={documents.preview_audio_video}
                thematics={documents.thematics}
        />
    </div>

    <style>
        .container {
            position: relative;
            height: 100vh;
            width: 100%;
            display: flex;
            flex-direction: column;
        }

        a {
            position: absolute;
            top: 50%;
            color: white;
            text-decoration: none;
            font-size: 2rem;
            transition: transform 0.3s ease-in-out, color 0.3s ease-in-out;
        }

        a:hover {
            text-decoration: none;
            color: #c5c5c5;
            transform: scale(1.2);
        }

        .prev{
            left: 30px;
        }

        .next{
            right: 30px;
        }
    </style>
</Layout>