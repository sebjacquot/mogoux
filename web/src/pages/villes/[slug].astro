---
import Carrousel from "../../components/Carrousel.astro";
import "../../styles/global.css";
import { Image } from "astro:assets";

// @ts-ignore
import type { Media, City } from "../../../../cms/src/generated-types.ts";
import Galerie from "../../components/Galerie.astro";


const { slug } = Astro.params;


let carousel: City | null = null;
try {
  const res = await fetch(`${import.meta.env.CMS_URL}/api/cities/slug/${slug}`);
  const data = await res.json();
  carousel = data;
  console.log("Carousel Data:", carousel); // Ajout d'une console pour vérifier les données récupérées
} catch (error) {
  console.error("Failed to fetch cities", error);
}

const items = carousel?.thematics?.map((thematic: any) => ({
  src: thematic.backgroundImage.filename,
  title: thematic.title,
  slug: thematic.slug,
  alt: thematic.alt,
  couleur: thematic.color
}))


const medias: any[] = carousel?.medias?.map((media: any) => ({
    type: media.type,
    src: `${import.meta.env.CMS_URL}${media.url}`,
    slug: media.slug,
})) ?? []
---

<head>
  <meta charset="UTF-8" />
</head>

<html>
  <main>
    <div class="rectangle"></div>
    <section class="content">
      <Carrousel items={items!} />

      <div class="frise grid-wrapper ">
       <Galerie medias={medias} />
      
      </div>

    </section>
  </main>
 
  <style scoped>
    body{
      background: none
    }
    *{ margin: 0;
    padding: 0;
  box-sizing: border-box;}

  img{
    max-width: 100%;
    height: auto;
    vertical-align: middle;
    display: inline-block;
  }
  .grid-wrapper > div{
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .grid-wrapper > div > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 5px;
  }
  .grid-wrapper {
    display: grid;
    grid-gap: 10px;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    grid-auto-rows: 200px;
    grid-auto-flow: dense;

    padding: 10px;


  }
  .grid-wrapper .wide{
    grid-column: span 2;
  }
  .grid-wrapper .tall{
    grid-row: span 2;
  }
  .grid-wrapper .big{
    grid-column: span 2;
    grid-row: span 2;
  }
    html {
      background: #000;
    }
    main {
      display: flex;
      flex-direction: column;

      width: 100%;
      height: 100%;
    }

    .rectangle {
      /* background: #242424; */
      width: 100vw;
      height: 80px;
      position: fixed;
      z-index: 1000;
      top: 0;
      left: 0;
    }

    .content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 50px;

      width: 97.5vw;
      /* margin-top: 96px; */
      margin: 100px auto 0 auto;
    }

    .buttons {
      display: flex;
      justify-content: space-between;
      align-items: center;

      height: 100%;

      margin-top: -20px;

      z-index: 11;

      button {
        border: none;
        outline: none;
        width: 30px;
        height: 110px;
        background: var(--primary-color);

        transition: all 0.2s ease-in;
      }
      button:nth-child(2) {
        border-top-left-radius: 4px;
        border-bottom-left-radius: 4px;
      }
      button:nth-child(1) {
        border-top-right-radius: 4px;
        border-bottom-right-radius: 4px;
      }

      button:hover {
        background: var(--secondary-color);
        width: 35px;
      }
    }
    .entete {
      width: 100%;
      height: 80vh;
      max-height: 700px;
      z-index: 1;
      border-radius: 4px;

      position: relative;
    }

    .index {
      display: flex;
      justify-content: center;
      align-items: center;
      position: absolute;

      gap: 20px;

      top: 20px;
      left: 30px;
      height: 20px;

      z-index: 2;
    }

    .pos {
      width: 110px;
      height: 5px;
      border-radius: 5px;
      background-color: white;
    }
    .checked {
    }

    .texte {
      display: flex;
      flex-direction: column;
      padding: 0 0 100px 100px;

      position: absolute;
      bottom: 0;
      left: 0;

      gap: 20px;

      color: white;
      z-index: 5;

      h3 {
        font-size: 50px;
        font-family: "Merryweather", sans-serif;c
        font-style: italic;
        font-weight: 300;
        border-bottom: 1px solid white;
        line-height: 65px;
        width: 23%;
      }

      h2 {
        font-size: 60px;
        font-family: var(--article-font);
        font-weight: bold;
        line-height: 65px;
        width: 60%;
      }
    }
  </style>
</html>
