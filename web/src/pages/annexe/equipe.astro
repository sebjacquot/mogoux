---
import Layout from "../../layouts/Layout.astro";
import ImageTooltip from "../../components/ImageTooltip.astro";
import {asset} from "../../utils/url";
---

<Layout title="Equipe">
    <div class="container">
        <section class="entete">
            <div class="hero">
                <h1 class="titre">Equipe</h1>
            </div>
            <ImageTooltip
                 src={asset('/images/Header_Chapitre/A1_0015.jpg')}
                 legend=""
                 alt=""
                 className="image-annexe"
            />
            <div class="overlay"></div>
        </section>


         <div class="team-list">
              <h2>Conception et direction générale du projet de webdocumentaire :</h2>
                    <ul>
                        <li>Pascal Lécroart, PU, UFC - ELLIADD</li>
                    </ul>
                <h2>L’équipe :</h2>
                    <ul>
                        <li>Quentin Arnoud, doctorant, UFC - ELLIADD</li>
                        <li>Jean-Baptiste Benoit, réalisateur</li>
                        <li>Andrée Chauvin-Vileno, PU émérite, UFC - ELLIADD</li>
                        <li>Thomas Dandin, Archiviste, UFC - ELLIADD</li>
                        <li>Yvon Houssais, PU, UFC - ELLIADD</li>
                        <li>Sébastien Jacquot, Ingénieur d’études, UFC - ELLIADD</li>
                        <li>David Michon, Docteur - Partenaire</li>
                        <li>Odile Roynette, PU, uB - LIR3S</li>
                        <li>Julie Soulès, maître d'oeuvre pour l'exposition</li>
                     </ul>
            <p>L'équipe tient à remercier Christopher Boulogne, Valentin Broissiat, 
Nicolas Guterlhe, Ilkay Men et Mathilda Schroll pour leur contribution générale au projet sur les archives de Jean-Paul Goux. </p>
                   
                    <p>Conception de la maquette du Webdocumentaire : Thomas Paquier et Paul Gravinese</p>
                    <p>Développement informatique du Webdocumentaire : Thomas Paquier et Paul Gravinese, avec l'appui de Sébastien Jacquot</p>
                    <p>Maintenance, suivi et gestion du Webdocumentaire : Sébastien Jacquot</p>
                    <p>L'équipe tient à remercier Ernest Chiarello et Cédric Degrelle pour le soutien apporté.<p>        
            </div>
        </div>
        <section class="credits">
            <div class="gauche">
                <p>
                    Droits photographiques : Madeure - Cités Blanches. <br/>
                    Photographie du 10 mars 1985 de Gilles Choffé
                </p>
            </div>
        </section>
    </div>


    <style scoped>
        @import "../../styles/annexes.css";

    </style>
</Layout>
