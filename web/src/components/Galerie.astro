---
import Bloc1 from "../components/Blocs/Bloc1.astro";
import Bloc2 from "../components/Blocs/Bloc2.astro";
import Bloc3 from "../components/Blocs/Bloc3.astro";
import Bloc4 from "../components/Blocs/Bloc4.astro";
import Bloc5 from "../components/Blocs/Bloc5.astro";
import Bloc6 from "../components/Blocs/Bloc6.astro";

type Props = {
    medias: {
        type: "image" | "audio" | "video";
        src: string;
        slug: string;
        titre: string;
    }[];
};

const {medias} = Astro.props;

const blocs = [
    {component: Bloc1, tile: 5},
    {component: Bloc2, tile: 3},
    {component: Bloc3, tile: 5},
    {component: Bloc4, tile: 6},
    {component: Bloc5, tile: 3},
    {component: Bloc6, tile: 6},
];

const shuffle = (items: any[]) => {
    return items.sort(() => Math.random() - 0.5);
};

shuffle(medias);

let results: any[] = [];
let blocIndex = 0;

for (let i = 0; i < medias.length;) {
    const {component, tile} = blocs[blocIndex];

    const blocMedias = medias.slice(i, i + tile);

    results.push({
        id: blocIndex,
        component,
        medias: blocMedias,
        isFull: blocMedias.length === tile, // Vérifie si le bloc est rempli au max
    });

    blocIndex = blocIndex >= blocs.length - 1 ? 0 : blocIndex + 1;
    i += blocMedias.length; // Avance du nombre réel d'éléments ajoutés
}

// Séparer les blocs remplis et non remplis
const fullResults = results.filter(({isFull}) => isFull);
const partialResults = results.filter(({isFull}) => !isFull);


shuffle(fullResults);
shuffle(partialResults);
results = [...fullResults, ...partialResults];


const mediasList: { slug: string }[] = [];

results.forEach(item => {
    item.medias.forEach((media: { slug: string }) => {
        mediasList.push({
            slug: media.slug
        });
    });
});
---

<section class="galerie">
    {results.map(({component: Bloc, medias}) =>
            <Bloc medias={medias} mediasList={mediasList}/>)}
</section>


<style scoped>
    .galerie {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(330px, 100%), 1fr));
        column-gap: 4px;
        grid-auto-rows: auto;
        height: auto;
    }
</style>



