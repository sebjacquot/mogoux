---
import Bloc1 from "./BlocsGalerie/Bloc1.astro";
import Bloc2 from "./BlocsGalerie/Bloc2.astro";
import Bloc3 from "./BlocsGalerie/Bloc3.astro";
import Bloc4 from "./BlocsGalerie/Bloc4.astro";
import Bloc5 from "./BlocsGalerie/Bloc5.astro";
import Bloc6 from "./BlocsGalerie/Bloc6.astro";

type Section = {
    id: number;
    name: string;
    rank: number;
    color: string;
    [key: string]: any;
};

type Document = {
    type: "Image" | "Audio" | "Video";
    src: string;
    alt: string;
    slug: string;
    section?: number[];
    titre: string;
    preview_audio_video: string | null;
};

type Props = {
    documents: Document[];
    sections?: Section[];
};

const { documents, sections } = Astro.props;

// Mélange un tableau aléatoirement
const shuffle = (items: any[]) => items.sort(() => Math.random() - 0.5);

// Étape 1 : Trier les sections par rank
const sortedSections = Array.isArray(sections)
    ? sections
        .filter(section => typeof section?.id === 'number' && typeof section?.rank === 'number')
        .sort((a, b) => a.rank - b.rank)
    : [];

// Étape 2 : Organiser les documents selon l'ordre des sections
let orderedDocuments: Document[] = [];

for (const section of sortedSections) {
    const docsInSection = documents.filter(doc =>
        Array.isArray(doc.section) && doc.section.includes(section.id)
    );
    orderedDocuments.push(...shuffle(docsInSection));
}

// Étape 3 : Ajouter les documents sans section à la fin
const docsWithoutSection = documents.filter(
    doc => !Array.isArray(doc.section) || doc.section.length === 0
);
orderedDocuments.push(...shuffle(docsWithoutSection));

// Étape 4 : Répartition dans les blocs
const blocs = [
    { component: Bloc1, tile: 5 },
    { component: Bloc2, tile: 3 },
    { component: Bloc3, tile: 5 },
    { component: Bloc4, tile: 6 },
    { component: Bloc5, tile: 3 },
    { component: Bloc6, tile: 6 },
];

let resultsFull: any[] = [];
let resultsPartial: any[] = [];
let blocIndex = 0;

for (let i = 0; i < orderedDocuments.length;) {
    const { component, tile } = blocs[blocIndex];

    const blocDocuments = orderedDocuments.slice(i, i + tile);

    const bloc = {
        id: blocIndex,
        component,
        documents: blocDocuments,
        isFull: blocDocuments.length === tile,
    };

    if (bloc.isFull) {
        resultsFull.push(bloc);
    } else {
        resultsPartial.push(bloc);
    }

    blocIndex = blocIndex >= blocs.length - 1 ? 0 : blocIndex + 1;
    i += blocDocuments.length;
}

const results = [...resultsFull, ...resultsPartial];

// Liste à plat des slugs pour paramètre `slugs`
const documentsList: { slug: string }[] = [];

results.forEach(item => {
    item.documents.forEach((document: { slug: string }) => {
        documentsList.push({ slug: document.slug });
    });
});
---

{documents.length > 0 && (
<hr style="width: 20%; margin-bottom: 20px; height: 2px; border: 1px solid #fff; border-radius: 5px; background-color: #fff">
<br>
    <section class="galerie">
<div style="width: 20%; margin-bottom: 20px; height: 5px; border-radius: 5px; background-color: #fff"></div>
        {results.map(({ component: Bloc, documents }) =>
                <Bloc documents={documents} documentsList={documentsList} />
        )}
    </section>
)}


<style scoped>
    .galerie {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(330px, 100%), 1fr));
        column-gap: 4px;
        grid-auto-rows: auto;
        height: auto;
    }
</style>



