---
import Bloc1 from "./BlocsGalerie/Bloc1.astro";
import Bloc2 from "./BlocsGalerie/Bloc2.astro";
import Bloc3 from "./BlocsGalerie/Bloc3.astro";
import Bloc4 from "./BlocsGalerie/Bloc4.astro";
import Bloc5 from "./BlocsGalerie/Bloc5.astro";
import Bloc6 from "./BlocsGalerie/Bloc6.astro";

type Props = {
    documents: {
        type: "Image" | "Audio" | "Video";
        src: string;
        alt: string;
        slug: string;
        titre: string;
        preview_audio_video: string | null;
    }[];
};

const {documents} = Astro.props;

const blocs = [
    {component: Bloc1, tile: 5},
    {component: Bloc2, tile: 3},
    {component: Bloc3, tile: 5},
    {component: Bloc4, tile: 6},
    {component: Bloc5, tile: 3},
    {component: Bloc6, tile: 6},
];

const shuffle = (items: any[]) => {
    return items.sort(() => Math.random() - 0.5);
};

const shuffledDocuments = [...documents].sort(() => Math.random() - 0.5);

let results: any[] = [];
let blocIndex = 0;

for (let i = 0; i < shuffledDocuments.length;) {
    const {component, tile} = blocs[blocIndex];

    const blocDocuments = shuffledDocuments.slice(i, i + tile);

    results.push({
        id: blocIndex,
        component,
        documents: blocDocuments,
        isFull: blocDocuments.length === tile, // Vérifie si le bloc est rempli au max
    });

    blocIndex = blocIndex >= blocs.length - 1 ? 0 : blocIndex + 1;
    i += blocDocuments.length; // Avance du nombre réel d'éléments ajoutés
}

// Séparer les blocs remplis et non remplis
const fullResults = results.filter(({isFull}) => isFull);
const partialResults = results.filter(({isFull}) => !isFull);


shuffle(fullResults);
shuffle(partialResults);
results = [...fullResults, ...partialResults];


const documentsList: { slug: string }[] = [];

results.forEach(item => {
    item.documents.forEach((document: { slug: string }) => {
        documentsList.push({
            slug: document.slug
        });
    });
});
---

{documents.length > 0 && (
    <section class="galerie">
        {results.map(({ component: Bloc, documents }) =>
                <Bloc documents={documents} documentsList={documentsList} />
        )}
    </section>
)}


<style scoped>
    .galerie {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(330px, 100%), 1fr));
        column-gap: 4px;
        grid-auto-rows: auto;
        height: auto;
    }
</style>



