---
import Image from "astro:assets";
import "../styles/global.css";

type Props = {
  src: string;
  legend: string;
};
const { src, legend } = Astro.props;
---

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const images = document.querySelectorAll(
      "img[data-enlargable]"
    ) as NodeListOf<HTMLImageElement>;
    images.forEach(function (img) {
      img.classList.add("img-enlargable");
      let isInFullScreen = false;

      const handleMouseEnter = function () {
        if (!isInFullScreen) {
          img.style.outline = "2px solid var(--text-color)";
          img.style.transition = "transform 0.3s ease";
          img.style.cursor = "zoom-in";
          img.style.transform = "scale(1.03)";
        }
      };

      const handleMouseLeave = function () {
        if (!isInFullScreen) {
          img.style.outline = "none";
          img.style.transform = "scale(1)";
        }
      };

      const handleClick = function () {
        img.removeEventListener("mouseenter", handleMouseEnter);
        img.removeEventListener("mouseleave", handleMouseLeave);

        var src = img.getAttribute("src");
        var alt = img.getAttribute("alt");

        var enlargedImage = document.createElement("div");
        enlargedImage.style.cssText = `
          background: RGBA(0,0,0,.5) url(${src}) no-repeat center;
          background-size: contain;
          width: 100vw;
          height: 100vh;
          position: fixed;
          z-index: 10000;
          top: 0;
          left: 0;
          cursor: zoom-out;
          opacity: 0;
          transition: opacity 0.5s ease; /* Transition pour l'entrée et la sortie */
        `;

        enlargedImage.addEventListener("click", function () {
          document.body.removeChild(enlargedImage);
          document.body.style.overflow = "visible"; // Réactiver l'overflow
          isInFullScreen = false;
          img.addEventListener("mouseenter", handleMouseEnter);
          img.addEventListener("mouseleave", handleMouseLeave);
        });

        document.body.appendChild(enlargedImage);
        document.body.style.overflow = "hidden"; // Bloquer l'overflow

        if (!isInFullScreen) {
          setTimeout(() => {
            enlargedImage.style.opacity = "1";
          }, 10);

          isInFullScreen = true;
        }
      };

      img.addEventListener("click", handleClick);
      img.addEventListener("mouseenter", handleMouseEnter);
      img.addEventListener("mouseleave", handleMouseLeave);
    });
  });
</script>

<img data-enlargable src={src} alt={legend} draggable="false" title={legend} />

<style scoped>
  img {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }
</style>
