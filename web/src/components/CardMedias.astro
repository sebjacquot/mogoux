---
import {asset} from "../utils/url";
type Props = {
  slug: string;
};

const { slug } = Astro.props;
---

<div class="paragraphe">
  <a href={asset(`/medias/${slug}`)}>link</a>
</div>

<style scoped>
  .paragraphe {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: start;
    max-width: 700px;
    margin: 0 auto;

    /* text-indent: 5%; */

    color: #222222;

    p {
      margin-bottom: 20px;
    }
    p:last-of-type {
      padding-bottom: 20px;
    }

    font-size: var(--texte-article-font-size);
    line-height: 1.6;
  }
</style>
