---
import ThematiqueCard from "../components/ThematiqueCard.astro";

type Props = {
    title: string;
    sectionId: string;
    color: string;
    thematics: Thematic[];
};

type Thematic = {
    id: string;
    title: string;
    slug: string;
    rank?: number | null;
};

const { title, sectionId, color, thematics } = Astro.props;

const sortedThematics = thematics.sort((a, b) => {
    const rankA = a.rank;
    const rankB = b.rank;

    if (rankA == null && rankB == null) return 0;
    if (rankA == null) return 1;
    if (rankB == null) return -1;

    return rankA - rankB;
});
---

<section class="thematique-section">
    <div class="row">
        <h2 class="titre">{title}</h2>
    </div>
    <hr />

    <div class="carousel-container" data-carousel-id="{title}">
        <button class="nav-btn left-btn" aria-label="Précédent">
            ❮
        </button>
        <div class="carousel-wrapper">
            <div class="carousel">
                {sortedThematics.map((thematic) => (
                    <div class="carousel-item">
                        <ThematiqueCard
                            idThematic={thematic?.id}
                            titre={thematic?.title}
                            slug={thematic?.slug}
                            color={color}
                            sectionId={sectionId}
                        />
                    </div>
                ))}
            </div>
        </div>
        <button class="nav-btn right-btn" aria-label="Suivant">
            ❯
        </button>
    </div>
</section>

<style scoped>
    hr {
        width: 100%;
        border: 0;
        height: 2px;
        background-color: rgba(255, 255, 255, 0.1);
        margin-bottom: 13px;
    }

    .row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
    }

    .titre {
        color: var(--secondary-color);
        font-family: var(--titres-font);
        font-size: 25px;
        font-weight: 700;
    }

    /* -------- CAROUSEL -------- */
    .carousel-container {
        position: relative;
        display: flex;
        align-items: center ;
        justify-content: center;
        width: 100%;
    }

    .carousel {
        display: flex;
        transition: transform 0.5s ease-in-out;
        will-change: transform;
        padding-left: 20px;
    }

    .carousel-item.one-per-slide {
        flex: 0 0 calc(100% - 20px);
        max-width: calc(100% - 20px);
        margin-right: 20px;
    }

    .carousel-item.two-per-slide {
        flex: 0 0 calc(50% - 20px);
        max-width: calc(50% - 20px);
        margin-right: 20px;
    }

    .carousel-item.three-per-slide {
        flex: 0 0 calc(33.333% - 20px);
        max-width: calc(33.333% - 20px);
        margin-right: 20px;
    }

    .carousel-wrapper {
        overflow: hidden;
        width: calc(100% - 20px);
    }

    .carousel::-webkit-scrollbar {
        display: none;
    }

    .nav-btn {
        position: absolute;
        top: 40%;
        background: rgba(0, 0, 0, 0);
        color: white;
        border: none;
        cursor: pointer;
        padding: 10px 15px;
        border-radius: 50%;
        z-index: 10;
        scale: 1.5;
        display: none;
        text-decoration: none;
        font-size: 1.5rem;
        transition: transform 0.3s ease-in-out, color 0.3s ease-in-out;
    }

    .nav-btn:hover {
        color: #c5c5c5;
        transform: scale(1.2);
    }

    .left-btn {
        left: -25px;
    }

    .right-btn {
        right: -25px;
    }

    .nav-btn:disabled {
        opacity: 0;
        cursor: default;
    }

</style>

<script is:inline>
    function cleanUpCarousel() {
        document.querySelectorAll(".carousel-container").forEach((carouselContainer) => {
            const newContainer = carouselContainer.cloneNode(true);
            carouselContainer.replaceWith(newContainer);
        });
    }

    function getResponsiveClass() {
        const width = window.innerWidth;
        if (width <= 768) return "one-per-slide";
        if (width <= 1200) return "two-per-slide";
        return "three-per-slide";
    }

    function initCarousel() {
        cleanUpCarousel();

        document.querySelectorAll(".carousel-container").forEach((carouselContainer) => {
            const carousel = carouselContainer.querySelector(".carousel");
            const prevBtn = carouselContainer.querySelector(".left-btn");
            const nextBtn = carouselContainer.querySelector(".right-btn");
            const items = carousel ? carousel.querySelectorAll(".carousel-item") : [];

            if (!carousel || !prevBtn || !nextBtn || items.length === 0) return;

            const responsiveClass = getResponsiveClass();

            items.forEach(item => {
                item.classList.remove("one-per-slide", "two-per-slide", "three-per-slide");
                item.classList.add(responsiveClass);
            });

            let scrollPosition = 0;
            const itemWidth = items[0].offsetWidth + 20;
            const wrapperWidth = carouselContainer.querySelector(".carousel-wrapper").offsetWidth;
            const visibleItems = Math.floor(wrapperWidth / itemWidth);
            const totalItems = items.length;
            const totalWidth = itemWidth * totalItems;
            const maxScroll = totalWidth - (itemWidth * visibleItems);

            function updateButtons() {
                const shouldHideArrows = totalItems <= visibleItems;

                if (scrollPosition <= 0 || shouldHideArrows) {
                    prevBtn.style.display = "none";
                } else {
                    prevBtn.style.display = "block";
                }

                if (scrollPosition >= maxScroll || shouldHideArrows) {
                    nextBtn.style.display = "none";
                } else {
                    nextBtn.style.display = "block";
                }
            }

            function moveCarousel(direction) {
                scrollPosition += direction * itemWidth;
                scrollPosition = Math.max(0, Math.min(scrollPosition, maxScroll));
                carousel.style.transform = `translateX(-${scrollPosition}px)`;
                updateButtons();
            }

            prevBtn.addEventListener("click", () => moveCarousel(-1));
            nextBtn.addEventListener("click", () => moveCarousel(1));

            updateButtons();
        });

        window.addEventListener("resize", () => {
            initCarousel();
        }, { once: true });
    }

    document.addEventListener("astro:after-swap", initCarousel);
    document.addEventListener("astro:page-load", initCarousel);
</script>