---
import ThematiqueCard from "../components/ThematiqueCard.astro";

type Thematic = {
    backgroundImage: { filename: string; alt: string };
    title: string;
    slug: string;
    color: string;
};

type Props = {
    title: string;
    thematics: Thematic[];
    sectionId: string;
};

const { title, thematics, sectionId } = Astro.props;
---

<section class="thematique-section">
    <div class="row">
        <h2 class="titre">{title}</h2>
    </div>
    <hr />

    <div class="carousel-container" data-carousel-id="{title}">
        <button class="nav-btn left-btn" aria-label="Précédent">
            ❮
        </button>
        <div class="carousel-wrapper">
            <div class="carousel">
                {thematics.map((thematic) => (
                    <div class="carousel-item">
                        <ThematiqueCard
                            src={(thematic.backgroundImage).url!}
                            titre={thematic.title}
                            slug={thematic.slug}
                            alt={(thematic.backgroundImage).alt!}
                            color={thematic.color}
                            sectionId={sectionId}
                        />
                    </div>
                ))}
            </div>
        </div>
        <button class="nav-btn right-btn" aria-label="Suivant">
            ❯
        </button>
    </div>
</section>

<script is:inline>
    function cleanUpCarousel() {
        document.querySelectorAll(".carousel-container").forEach((carouselContainer) => {
            const newContainer = carouselContainer.cloneNode(true);
            carouselContainer.replaceWith(newContainer);
        });
    }

    function initCarousel() {
        cleanUpCarousel();

        document.querySelectorAll(".carousel-container").forEach((carouselContainer) => {
            const carousel = carouselContainer.querySelector(".carousel");
            const prevBtn = carouselContainer.querySelector(".left-btn");
            const nextBtn = carouselContainer.querySelector(".right-btn");
            const items = carousel ? carousel.querySelectorAll(".carousel-item") : [];

            if (!carousel || !prevBtn || !nextBtn || items.length === 0) return;

            let scrollPosition = 0;
            const itemWidth = items[0].offsetWidth + 20;
            const visibleItems = 3;
            const totalItems = items.length;
            const totalWidth = itemWidth * totalItems;
            const maxScroll = totalWidth - (itemWidth * visibleItems);

            function updateButtons() {
                const shouldHideArrows = totalItems <= visibleItems;
                prevBtn.style.display = shouldHideArrows ? "none" : "block";
                nextBtn.style.display = shouldHideArrows ? "none" : "block";
                prevBtn.classList.toggle("hidden", scrollPosition <= 0);
                nextBtn.classList.toggle("hidden", scrollPosition >= maxScroll);
            }

            function moveCarousel(direction) {
                scrollPosition += direction * itemWidth;
                scrollPosition = Math.max(0, Math.min(scrollPosition, maxScroll));
                carousel.style.transform = `translateX(-${scrollPosition}px)`;
                updateButtons();
            }

            prevBtn.addEventListener("click", () => moveCarousel(-1));
            nextBtn.addEventListener("click", () => moveCarousel(1));

            updateButtons();
        });
    }

    document.addEventListener("astro:after-swap", initCarousel);
    document.addEventListener("astro:page-load", initCarousel);
</script>

<style scoped>
    hr {
        width: 100%;
        border: 0;
        height: 2px;
        background-color: rgba(255, 255, 255, 0.1);
        margin-bottom: 13px;
    }

    .row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
    }

    .titre {
        color: var(--secondary-color);
        font-family: var(--titres-font);
        font-size: 25px;
        font-weight: 700;
    }

    /* -------- CAROUSEL -------- */
    .carousel-container {
        position: relative;
        display: flex;
        align-items: center ;
        justify-content: center;
        width: 100%;
    }

    .carousel {
        display: flex;
        transition: transform 0.5s ease-in-out;
        will-change: transform;
        padding-left: 20px;
    }

    .carousel-item {
        flex: 0 0 calc(100% / 3 - 20px);
        max-width: calc(100% / 3 - 20px);
        margin-right: 20px;
    }

    .carousel-wrapper {
        overflow: hidden;
        width: calc(100% - 20px);
    }

    .carousel::-webkit-scrollbar {
        display: none;
    }

    .nav-btn {
        position: absolute;
        top: 40%;
        background: rgba(0, 0, 0, 0);
        color: white;
        border: none;
        cursor: pointer;
        padding: 10px 15px;
        border-radius: 50%;
        z-index: 10;
        scale: 1.5;
        display: none;
        text-decoration: none;
        font-size: 1.5rem;
        transition: transform 0.3s ease-in-out, color 0.3s ease-in-out;
    }

    .nav-btn:hover {
        color: #c5c5c5;
        transform: scale(1.2);
    }

    .left-btn {
        left: -25px;
    }

    .right-btn {
        right: -25px;
    }

    .nav-btn:disabled {
        opacity: 0;
        cursor: default;
    }
</style>