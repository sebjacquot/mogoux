---
import ThematiqueCard from "../components/ThematiqueCard.astro";
import "../styles/global.css";

// @ts-ignore
import type { Thematic, Media } from "../../../cms/src/generated-types.ts";

type Props = {
  title: string;
  files: string;
  thematics: Thematic[];
};

const { title, files, thematics } = Astro.props;
---

<section class="thematique-section">
  <div class="thematique">
    <div class="row">
      <h2 class="titre">{title}</h2>
      <a
        class="button"
        href={`${import.meta.env.CMS_URL}/documents/${files}`}
        download>Télécharger</a
      >
    </div>
    <hr />
    <div class="thematique-inner">
      {
        thematics.map((thematic) => (
          <ThematiqueCard
            src={(thematic.backgroundImage as Media).filename!}
            titre={thematic.title}
            slug={thematic.slug}
            alt={(thematic.backgroundImage as Media).alt!}
          />
        ))
      }
    </div>
  </div>
</section>
<style scoped>
  hr {
    width: 100%;
    border: 0;
    height: 2px;
    background-color: rgba(255, 255, 255, 0.1);
    margin-bottom: 13px;
  }
  .button {
    text-decoration: none;
    color: rgba(255, 255, 255, 0.8);
    font-size: 15px;
    font-weight: 700;

    border: 2px solid rgba(255, 255, 255, 0.8);
    border-radius: 5px;
    padding: 5px 10px;
    transition: all 0.3s ease;
  }

  .button:hover {
    background-color: var(--secondary-color);
    color: var(--bg-color);
  }

  .row {
    display: flex;
    align-self: flex-start;
    width: 100%;
    justify-content: space-between;
  }
  .titre {
    align-self: flex-start;
    color: var(--secondary-color);
    font-family: var(--titres-font);
    font-size: 25px;
    font-weight: 700;
    margin-bottom: 0px;
  }

  .thematique {
    display: flex;
    flex-direction: column;
    /* margin: 50px auto 0 auto; */
  }
  .thematique-inner {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 70px;
    column-gap: 40px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .card:hover {
    h3 {
      color: #ff7979;
    }
  }

  .rectangle {
    width: 300px;
    height: 200px;
    background-image: url("https://source.unsplash.com/random");
    background-size: cover;
    background-position: center;
  }

  .card:hover .rectangle::after {
    content: "";
    display: block;
    width: 100%;
    height: 100%;
    background: rgba(255, 121, 121, 0.502);
  }

  h3 {
    font-size: 20px;
    font-weight: 700;
  }
</style>
