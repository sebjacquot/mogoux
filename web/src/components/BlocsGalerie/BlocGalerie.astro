---
import AudioVideoCard from "../AudioVideoCard.astro";
import { asset } from "../../utils/url";

type Props = {
    document: {
        type: "Image" | "Audio" | "Video";
        src: string;
        alt: string;
        slug: string;
        titre: string;
        section?: [];
        preview_audio_video: string | null;
    };
    documentsList: { slug: string }[];
};

const { document, documentsList } = Astro.props;
const slugsParam = documentsList.length > 0
    ? encodeURIComponent(documentsList.map(m => m.slug).join(","))
    : "";
---

<a
        data-dynamic-url
        href={asset(`/documents/${document.slug}?slugs=${encodeURIComponent(slugsParam)}&from=__CURRENT_URL__`)}
        onclick="event.preventDefault(); this.href = this.href.replace('__CURRENT_URL__', encodeURIComponent(window.location.href)); window.location.href = this.href;"
>
    {document.type === "Audio" || document.type === "Video" ? (
            <AudioVideoCard preview_audio_video={document.preview_audio_video} />
    ) : (
            <img class="image" src={document.src} loading="lazy" alt={document.alt} />
    )}

    <h3>{document.titre}</h3>
</a>

<style scoped>
    a {
        display: block;
        width: 100%;
        height: 100%;
        position: relative;
    }

    a .image {
        object-fit: cover;
        width: 100%;
        height: 100%;
        display: block;
        border-radius: 3px;
        position: relative;
        z-index: 0;
    }

    h3 {
        position: absolute;
        bottom: 0;
        left: 0;
        text-align: center;
        width: calc(100% - 10px);
        font-size: 17px;
        color: whitesmoke;
        font-weight: 700;
        font-family: var(--primary-font);
        line-height: 1.1;
        padding: 0 5px 10px 5px;
        z-index: 2;
        opacity: 0;
        transition: all 0.5s;
    }

    a:after {
        content: "";
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0);
        z-index: 1;
        border-radius: 3px;
        border: 2px solid transparent;
        transition: all 0.3s;
    }

    a:hover:after {
        background-color: rgba(0, 0, 0, 0.6);
        border: 2px solid var(--secondary-color);
    }

    a:hover h3 {
        opacity: 1;
    }
</style>