---
import BlocGalerie from "./BlocGalerie.astro";

type Props = {
  documents: {
    type: "Image" | "Audio" | "Video";
    src: string;
    alt: string;
    slug: string;
    titre: string;
    preview_audio_video: string | null;
  }[];

  documentsList: []
};

const { documents, documentsList } = Astro.props;
---

<div class="bloc4">
  <div class="row-3-4-col-right">
    <div class="rectangle orange">
      {documents[0] && <BlocGalerie document={documents[0]} documentsList={documentsList} />}
    </div>
    <div class="col-2-5">
      <div class="rectangle rouge">
        {documents[1] && <BlocGalerie document={documents[1]} documentsList={documentsList} />}
      </div>
      <div class="rectangle vert">
        {documents[2] && <BlocGalerie document={documents[2]} documentsList={documentsList} />}
      </div>
    </div>
  </div>
  <div class="row-1-5-col-right">
    <div class="rectangle bleu">
      {documents[3] && <BlocGalerie document={documents[3]} documentsList={documentsList} />}
    </div>
    <div class="col-2-4">
      <div class="rectangle rose">
        {documents[4] && <BlocGalerie document={documents[4]} documentsList={documentsList} />}
      </div>
      <div class="rectangle violet">
        {documents[5] && <BlocGalerie document={documents[5]} documentsList={documentsList} />}
      </div>
    </div>
  </div>
</div>

<style scoped>
  .bloc4 {
    display: flex;
    flex-direction: column;
    height: 501px;
    width: 100%;
    gap: 4px;

    div {
      gap: 4px;
    }
  }

  .image {
    object-fit: cover;
    width: 100%;
    height: 100%;
    border-radius: 3px;
  }
  .rectangle {
    height: 100%;
    border-radius: 3px;
  }
  .col-2-5 {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 46%;
    height: 100%;

    .rectangle:nth-child(1) {
      width: 100%;
      height: 41%;
    }
    .rectangle:nth-child(2) {
      width: 100%;
      height: 57%;
    }
  }
  .row-3-4-col-right {
    display: flex;
    height: 250px;
  }
  .row-3-4-col-right > .rectangle:nth-child(1) {
    width: 54%;
  }
  .row-1-5-col-right {
    display: flex;
    flex-direction: row;
    height: 242px;
    overflow: hidden;
  }
  .row-1-5-col-right > .rectangle:nth-child(1) {
    width: 47.6%;
  }
  .col-2-4 {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 52.5%;
    height: 100%;

    .rectangle:nth-child(1) {
      height: 49%;
    }
    .rectangle:nth-child(2) {
      height: 49%;
    }
  }
</style>
