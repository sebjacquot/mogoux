---
import BlocGalerie from "./BlocGalerie.astro";

type Props = {
  documents: {
    type: "Image" | "Audio" | "Video";
    src: string;
    alt: string;
    slug: string;
    titre: string;
    section?: [];
    preview_audio_video: string | null;
  }[];

  documentsList: []
};

const { documents, documentsList } = Astro.props;
---

<div class="bloc3">
  <div class="row-3-4">
    <div class="rectangle bleu">
      {documents[0] && <BlocGalerie document={documents[0]} documentsList={documentsList} />}
    </div>
    <div class="rectangle rose">
      {documents[1] && <BlocGalerie document={documents[1]} documentsList={documentsList} />}
    </div>
  </div>
  <div class="row-1-2-reversed">
    <div class="rectangle vert">
      {documents[2] && <BlocGalerie document={documents[2]} documentsList={documentsList} />}
    </div>
    <div class="rectangle violet">
      {documents[3] && <BlocGalerie document={documents[3]} documentsList={documentsList} />}
    </div>
  </div>
  <div class="row-large">
    <div class="rectangle rouge">
      {documents[4] && <BlocGalerie document={documents[4]} documentsList={documentsList} />}
    </div>
  </div>
</div>

<style scoped>
  .bloc3 {
    display: flex;
    flex-direction: column;
    height: 501px;
    width: 100%;
    gap: 4px;

    div {
      gap: 4px;
    }
  }

  .image {
    object-fit: cover;
    width: 100%;
    height: 100%;
    border-radius: 3px;
  }
  .row-1-2-reversed {
    display: flex;
    flex-direction: row;
    height: 104px;
    width: 100%;

    .rectangle:nth-child(1) {
      width: 47.5%;
    }
    .rectangle:nth-child(2) {
      width: 52.5%;
    }
  }

  .row-large {
    display: flex;
    flex-direction: row;
    height: 207px;
    width: 100%;

    .rectangle {
      width: 100%;
      border-radius: 3px;
    }
  }
  .row-3-4 {
    display: flex;
    flex-direction: row;
    height: 177px;
    width: 100%;

    .rectangle:nth-child(1) {
      width: 61.6%;
    }
    .rectangle:nth-child(2) {
      width: 38.4%;
    }
  }
</style>
