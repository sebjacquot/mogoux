---
import BlocGalerie from "./BlocGalerie.astro";

type Props = {
  documents: {
    type: "Image" | "Audio" | "Video";
    src: string;
    alt: string;
    slug: string;
    titre: string;
    preview_audio_video: string | null;
  }[];

  documentsList: []
};

const { documents, documentsList } = Astro.props;
---

<div class="bloc2">
  <div class="row-2-5">
    <div class="rectangle violet">
      {documents[0] && <BlocGalerie document={documents[0]} documentsList={documentsList} />}
    </div>
    <div class="rectangle rouge">
      {documents[1] && <BlocGalerie document={documents[1]} documentsList={documentsList} />}
    </div>
  </div>
  <div class="row-big">
    <div class="rectangle orange">
      {documents[2] && <BlocGalerie document={documents[2]} documentsList={documentsList} />}
    </div>
  </div>
</div>

<style scoped>
  .image {
    object-fit: cover;
    width: 100%;
    height: 100%;
    border-radius: 3px;
  }

  .bloc2 {
    display: flex;
    flex-direction: column;
    height: 501px;
    width: 100%;
    gap: 4px;

    div {
      gap: 4px;
    }
  }

  .row-2-5 {
    display: flex;
    flex-direction: row;
    height: 227px;
    width: 100%;
    .rectangle:nth-child(1) {
      width: 56%;
    }
    .rectangle:nth-child(2) {
      width: 60%;
    }
  }
  .row-big {
    display: flex;
    flex-direction: row;
    height: 266px;
    width: 100%;

    .rectangle {
      width: 100%;
      border-radius: 3px;
    }
  }
</style>
