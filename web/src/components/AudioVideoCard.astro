---
const {preview_audio_video} = Astro.props;
---

<div class="audio-video-card" style={`background-image: url(${preview_audio_video})`}>
  <div class="overlay"></div>
  <div class="play-button">
    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="white" class="bi bi-play-circle" viewBox="0 0 16 16">
      <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
      <path d="M6.271 5.055a.5.5 0 0 1 .52.038l3.5 2.5a.5.5 0 0 1 0 .814l-3.5 2.5A.5.5 0 0 1 6 10.5v-5a.5.5 0 0 1 .271-.445"/>
    </svg>
  </div>
</div>

<style scoped>
  .audio-video-card {
    position: relative;
    width: 100%;
    height: 100%;
    background-position: center;
    background-size: cover;
    border-radius: 3px;
    display: flex;
    justify-content: end;
    align-items: start;
    overflow: hidden;
  }

  .audio-video-card .overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1;
    pointer-events: none;
  }

  .play-button svg {
    position: absolute;
    z-index: 2;
    top: 10px;
    right: 10px;
  }

</style>
