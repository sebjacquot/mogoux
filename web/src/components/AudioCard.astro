---
import { asset } from "../utils/url";
import Audio from "./Audio.astro";

type Props = {
  src: string;
};

const { src } = Astro.props;
---

<div class="audio">
  <Audio src={src} />
</div>
<div class="audio-card" id="audioCard" style={`background-image: url(${asset("/Goux_1000kB_3.jpg")})`}>
  <img src={asset("/icones/play-icon.png")} alt="icone controle son" id="playicon" />
</div>

<style scoped>
  .audio {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: #242424;
    padding: 10px 0;
    opacity: 0;
    z-index: -1;
    transition: opacity 0.5s, z-index 0.3s;
  }

  .audio-card {
    width: 100% !important;
    height: 100% !important;

    background-position: center;
    background-size: cover;
    border-radius: 3px;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .audio-card::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
  }

  img {
    width: 50px;
    height: 50px;
    object-fit: contain;
    z-index: 50;
  }

  img:hover{
    cursor: pointer;
  }
</style>

<script>
  const audio = document.querySelector(".audio") as HTMLDivElement;
  const rectangle = document.querySelector(".audio-card") as HTMLDivElement;

  const audioStart = new CustomEvent("audiostart");

  document.querySelector("#closeBtn")?.addEventListener("audioclose", () => {
    audio.style.opacity = "0";
    audio.style.zIndex = "-1";
  });

  rectangle.addEventListener("click", () => {
    audio.style.opacity = "1";
    audio.style.zIndex = "100";

    rectangle.dispatchEvent(audioStart);
  });
</script>
