---
import { asset } from "../utils/url";
---

<div class="audio-card" id="audioCard" style={`background-image: url(${asset("/Goux_1000kB_3.jpg")})`}>
  <img src={asset("/icones/play-icon.png")} alt="icone controle son" id="playicon" />
</div>

<style scoped>
  .audio-card {
    width: 100% !important;
    height: 100% !important;

    background-position: center;
    background-size: cover;
    border-radius: 3px;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .audio-card::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
  }

  img {
    width: 50px;
    height: 50px;
    object-fit: contain;
    z-index: 50;
  }

  img:hover{
    cursor: pointer;
  }
</style>
