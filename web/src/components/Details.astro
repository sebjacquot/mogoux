---
import AudioCard from "./AudioCard.astro";
import ImageFullscreen from "./ImageFullscreen.astro";

type Props = {
  titre: string;
  date: string;
  description: string;
  tags: string[];
  lieu_name: string;
  lieu_link: string;
  credits_name: string;
  credits_link: string;
  type: string;
  link_notice: string;
  src: string;
  alt: string;
};

const props = Astro.props;
---

<div class="row">
  <div class="texte">
    <h1 class="titre">{props.titre}</h1>
    <h3 class="date">{props.date}</h3>
    <p class="description">{props.description}</p>
    <ul class="liste">
      {props.tags.map((tag) => <li class="mot-cle">{tag}</li>)}
    </ul>
    <div class="datas">
      <div class="gauche">
        <div class="row-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <h3>Lieu</h3>
        </div>
        <div class="row-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
          </svg>
          <h3>Type</h3>
        </div>
        <div class="row-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="5"></circle>
            <path d="M20 21a8 8 0 0 0-16 0"></path>
          </svg>
          <h3>Crédits</h3>
        </div>
      </div>
      <div class="droite">
        <div class="row-link">
          <a href={props.lieu_link} target="_blank" rel="noopener noreferrer">{props.lieu_name}</a>
        </div>
        <h3>{props.type}</h3>
        <div class="row-link">
          <a href={props.credits_link} target="_blank" rel="noopener noreferrer">{props.credits_name}</a>
        </div>
      </div>
    </div>
  </div>

  <div class="rectangle-image">
    <div class="image">
      {
        props.type === "audio" ? (
            <AudioCard src={`${import.meta.env.CMS_URL}/medias/${props.src}`} />
        ) : (
            <ImageFullscreen
                src={`${import.meta.env.CMS_URL}/medias/${props.src}`}
                legend={props.alt}
            />
        )
      }
    </div>

    <a href={props.link_notice} target="_blank" rel="noopener noreferrer" class="icon-link">
      <!--<svg
          xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-arrow-out-up-right">
        <path d="M21 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6"></path>
        <path d="m21 3-9 9"></path>
        <path d="M15 3h6v6"></path>
      </svg>-->
    </a>
  </div>
</div>

<style scoped>
  .row {
    display: flex;
    align-items: start;
    padding: 6% 8%;
    gap: 5em;
    color: white;
  }

  .texte {
    display: flex;
    flex-direction: column;
    width: 45%;
    font-size: 20px;
  }

  .titre {
    font-size: 2em;
    font-weight: 700;
    margin: 50px 0 30px;
  }

  .date {
    font-size: 17px;
    margin-bottom: 20px;
    font-family: var(--merriweather);
  }

  .description {
    margin-bottom: 1.5em;
    width: 90%;
    line-height: 1.2;
    text-align: justify;
  }

  .liste {
    margin-bottom: 1em;
    display: flex;
    gap: 5px;
  }

  .mot-cle {
    border: 1px solid var(--navigation);
    color: var(--navigation);
    padding: 2px 7px;
    border-radius: 5px;
    font-size: 1rem;
    margin-bottom: 4em;
  }

  .datas {
    display: flex;
    justify-content: flex-start;
    margin-top: auto;
    font-size: 0.9em;
    width: 100%;

    h3{
      text-align: start;
    }
  }

  .droite{
    width: 100%;
    margin: 0 5%;
  }

  .row-icon {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .row-link {
    display: flex;
    align-items: center;
  }

  a {
    color: white;
    text-decoration: none;
    cursor: pointer;
  }

  a:hover {
    text-decoration: underline;
    color: rgba(255, 255, 255, 0.7);
  }

  .rectangle-image {
    width: 1200px;
    height: 650px;
    position: relative;
  }

  .image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .icon-link {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
  }

  .icon-link svg {
    width: 40px;
    height: 40px;
    stroke: white;
    stroke-width: 2;
    transition: stroke 0.2s ease-in-out;
  }

  .icon-link:hover svg {
    stroke: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 1024px) {
    .row {
      flex-direction: column;
      align-items: center;
      padding: 5%;
      gap: 2em;
      text-align: center;
    }

    .texte {
      margin-top: 10%;
      width: 100%;
      text-align: center;
    }

    .titre {
      font-size: 36px;
      margin: 20px 0;
    }

    .date {
      font-size: 16px;
      margin-bottom: 10px;
    }

    .description {
      width: 100%;
      font-size: 18px;
      line-height: 1.3;
    }

    .liste {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
    }

    .mot-cle {
      font-size: 0.85rem;
      padding: 5px 10px;
      white-space: nowrap;
    }

    .rectangle-image {
      width: 95%;
      height: auto;
    }

    .image {
      width: 100%;
      height: auto;
    }

    .icon-link {
      width: 35px;
      height: 35px;
      top: 10px;
      right: 10px;
    }

    .icon-link svg {
      width: 28px;
      height: 28px;
    }
  }

  @media (max-width: 768px) {
    .titre {
      font-size: 28px;
    }

    .texte {
      font-size: 16px;
    }

    .mot-cle {
      font-size: 0.75rem;
      padding: 3px 8px;
    }

    .rectangle-image {
      width: 100%;
    }

    .icon-link {
      width: 30px;
      height: 30px;
    }

    .icon-link svg {
      width: 24px;
      height: 24px;
    }
  }
</style>