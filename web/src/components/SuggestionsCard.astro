---
import "../styles/global.css";
type Props = {
  titre: string;
  numero_chapitre: string;
  lien_image: string;
};

const { titre, numero_chapitre, lien_image } = Astro.props;
---

<a href=`/chapitres/chapitre${numero_chapitre}`>
  <div class="card">
    <div class="overlay2"></div>
    <img
      src=`/images/Header_Chapitre/${lien_image}`
      alt=`image du chapitre ${numero_chapitre}`
    />
    <div class="tag-card">
      <h4>CHAPITRE {numero_chapitre}</h4>
    </div>
    <h3 class="titre">
      {titre}
    </h3>
  </div>
</a>

<style scoped>
  .card {
    width: 300px;
    height: 180px;
    overflow: hidden;
    border-radius: 2px;
    position: relative;

    h3 {
      font-size: 18px;
      line-height: 18px;
      font-family: var(--article-font); /* Helvetica */
      font-weight: 600;

      width: 100%;

      text-align: center;

      color: white;
      position: absolute;
      bottom: 10px;
      left: 0;
      z-index: 20;
    }
    img {
      /* max-width: 100%;
      max-height: 100%; */
      width: 100%;
      height: 100%;
      transition: transform 0.3s ease;
      position: relative;
      scale: 1.2;
      z-index: 1;
    }
    .overlay2 {
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.4);
      position: absolute;
      top: 0;
      left: 0;
      z-index: 5;

      transition: all 0.3s ease;
    }
  }
  .card:hover .overlay2 {
    background: rgba(231, 36, 101, 0.3);
  }

  .tag-card {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 5;
    padding: 5px 10px;

    border-radius: 2px;
    background: rgb(231, 36, 101) !important;
    h4 {
      width: auto !important;
      text-transform: uppercase;
      text-align: center;
      color: #fff;
      font-family: var(--article-font);
      font-weight: bold;
      font-size: 0.75rem;
      line-height: 1rem;
    }
  }
</style>
