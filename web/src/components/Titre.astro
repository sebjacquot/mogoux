---
import "../styles/global.css";
type Props = {
  titre: string;
};

const { titre } = Astro.props;
---

<h2 class="titres">{titre}</h2>

<style scoped>
  .titres {
    font-size: var(--titre-paragraphe-font-size);

    font-weight: bold;
    padding-bottom: 5px;

    margin: 0 auto;
    max-width: 700px;

    color: rgb(22, 22, 22);
  }
</style>
