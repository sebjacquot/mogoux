---
import "../styles/global.css";



type Props = {
  items: {
    src: string;
    title: string;
    alt: string;
    couleur: string;
    slug: string;
  }[];
};

const { items } = Astro.props;
---

<body>
  <div class="carousel">
    <div class="index">
      {items.map(() => <div class="index-pos" />)}
    </div>
    <div class="buttons">
      <button class="prev" onclick="moveCarousel(-1)">&#10094;</button>
      <button class="next" onclick="moveCarousel(1)">&#10095;</button>
    </div>
    <div class="carousel-inner">
      {
        items.map((item) => (
          <a id="test" href={`/thematiques/${item.slug}`}>
            <div class="carousel-element">
              <img
                class="image"
                src={`${import.meta.env.CMS_URL}/medias/${item.src}`}
                alt={item.alt}
              />{" "}
              {/* Check if alt array exists */}
              <div class="texte">
                <h3>Thématique</h3>
                <h2 class="titre">{item.title}</h2>{" "}
                {/* Check if titre array exists */}
              </div>
            </div>
            <div class="overlay" style={`background: ${item.couleur}`} />
            <div class="overlay2" />
          </a>
        ))
      }
    </div>
  </div>
</body>
<script lang="scripts.js">
  let currentIndex = 0;

  function moveCarousel(direction) {
    const carouselInner = document.querySelector(".carousel-inner");
    const totalImages = document.querySelectorAll(
      ".carousel-inner .carousel-element"
    ).length;
    const carouselWidth = document.querySelector(".carousel").clientWidth;

    currentIndex += direction;

    if (currentIndex < 0) {
      currentIndex = totalImages - 1;
    } else if (currentIndex >= totalImages) {
      currentIndex = 0;
    }

    carouselInner.style.transform = `translateX(-${
      currentIndex * carouselWidth
    }px)`;

    updateIndicators();
  }

  function updateIndicators() {
    const indicators = document.querySelectorAll(".index .index-pos");
    indicators.forEach((indicator, index) => {
      if (index === currentIndex) {
        indicator.classList.add("checked");
      } else {
        indicator.classList.remove("checked");
      }
    });
  }

  // Initialize the indicators on page load
  document.addEventListener("DOMContentLoaded", updateIndicators);
</script>

<style scoped>
  .carousel {
    background: rgba(0, 0, 255, 0.8);
    width: 100%;
    height: 80vh;
    max-height: 700px;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  .carousel-inner {
    display: flex;
    transition: transform 0.5s ease-in-out;
    height: 100%;
  }

  #test {
    position: relative;
    width: 100%;
    flex: 0 0 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
  }

  .image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: relative;
  }
  .carousel-element {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }
  .overlay {
    z-index: -10;
  }
  .overlay2 {
    background: rgba(0, 0, 0, 0.5);
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 4;
  }

  #test:hover .overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0.5;
    z-index: 4;
  }
  #test:hover .overlay2 {
    z-index: -10;
  }

  .buttons {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: absolute;
    top: 50%;
    width: 100%;
    transform: translateY(-50%);
    z-index: 10;
  }

  .buttons button {
    border: none;
    outline: none;
    width: 30px;
    height: 110px;
    background: var(--primary-color);
    color: white;
    transition: all 0.2s ease-in;
  }

  .buttons button:nth-child(2) {
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
  }

  .buttons button:nth-child(1) {
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
  }

  .buttons button:hover {
    background: var(--secondary-color);
    width: 35px;
    color: black;
    cursor: pointer;
  }

  .index {
    display: flex;
    justify-content: center;
    align-items: center;
    position: absolute;
    top: 20px;
    left: 30px;
    gap: 20px;
    z-index: 10;
  }

  .index-pos {
    width: 110px;
    height: 5px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.5);
  }

  .checked {
    background-color: white;
  }

  .texte {
    display: flex;
    flex-direction: column;
    padding: 0 0 100px 100px;
    width: fit-content;

    position: absolute;
    bottom: 0;
    left: 0;

    gap: 20px;

    color: white;
    z-index: 5;

    h3 {
      font-size: 50px;
      font-family: "Merryweather", sans-serif;
      font-style: italic;
      font-weight: 300;
      border-bottom: 1px solid white;
      line-height: 65px;
      width: fit-content;
    }

    h2 {
      font-size: 60px;
      font-family: var(--article-font);
      font-weight: bold;
      line-height: 65px;
      width: 60%;
    }
  }
</style>
