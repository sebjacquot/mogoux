---
import Galerie from "./Galerie.astro";

type Props = {
  thematics: {
    src: string;
    title: string;
    alt: string;
    couleur: string;
    slug: string;
    documents: any[];
  }[];
  positionSlugThematique: string;
};

const { thematics = [], positionSlugThematique} = Astro.props;

const reorderedThematics = thematics
    .map(thematic => ({
      ...thematic,
      documents: thematic.documents.map(document => ({
        type: document.type,
        src: `${import.meta.env.CMS_BASE_URL}${document.sizes.preview.url ?? document.url}`,
        alt: document.alt,
        slug: document.slug,
        titre: document.title,
        preview_audio_video: `${import.meta.env.CMS_BASE_URL}${document.preview_audio_video?.sizes?.preview?.url ?? null}`
      })),
    }));

console.log("reorderedThematics titles", reorderedThematics.map(t => t.title));

const selectedIndex = reorderedThematics.findIndex(
    (thematic) => thematic.slug === positionSlugThematique
);
---

<div class="carousel" data-selected-index={selectedIndex}>
    <div class="index">
      {reorderedThematics.map(() =>
          <div class="index-pos" />
      )}
    </div>
    <div class="buttons">
      <button class="prev" onclick="moveCarousel(-1)">&#10094;</button>
      <button class="next" onclick="moveCarousel(1)">&#10095;</button>
    </div>
    <div class="carousel-inner">
      {
        reorderedThematics.map((thematic) => (
            <div class="carousel-element"
                 data-slug={thematic.slug}
                 data-medias={JSON.stringify(thematic.documents)}>
              <img
                class="image"
                src={thematic.src}
                alt={thematic.alt}
                loading="lazy"
              />
              <div class="texte">
                <h3>Thématique</h3>
                <h2 class="titre">{thematic.title}</h2>
              </div>
              <div class="overlay2" />
            </div>
        ))
      }
    </div>
  </div>
<section id="media-section">
  {reorderedThematics.map((thematic, index) => (
      <div class="gallery" data-gallery-index={index} style={index === 0 ? "display: block;" : "display: none;"}>
        <Galerie documents={thematic.documents} />
      </div>
  ))}
</section>

<style scoped>
  .carousel {
    width: 100%;
    height: 55vh;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    z-index: 1;
    margin-bottom: 20px;
  }

  .carousel-inner {
    display: flex;
    transition: transform 0.5s ease-in-out;
    height: 100%;
  }

  .image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: relative;
  }
  .carousel-element {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 0 0 100%;
  }

  .overlay2 {
    background: rgba(0, 0, 0, 0.5);
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 4;
  }

  .buttons {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: absolute;
    top: 50%;
    width: 100%;
    transform: translateY(-50%);
    z-index: 10;
  }

  .buttons button {
    border: none;
    outline: none;
    width: 30px;
    height: 110px;
    background: var(--primary-color);
    color: white;
    transition: all 0.2s ease-in;
  }

  .buttons button:nth-child(2) {
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
  }

  .buttons button:nth-child(1) {
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
  }

  .buttons button:hover {
    background: var(--secondary-color);
    width: 35px;
    color: black;
    cursor: pointer;
  }

  .index {
    display: flex;
    justify-content: center;
    align-items: center;
    position: absolute;
    top: 20px;
    left: 30px;
    gap: 20px;
    z-index: 10;
  }

  .index-pos {
    width: 110px;
    height: 5px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.5);
  }

  .checked {
    background-color: white;
  }

  .texte {
    display: flex;
    flex-direction: column;
    padding: 0 100px 100px 100px;
    width: 100vw;
    position: absolute;
    bottom: 0;
    left: 0;
    gap: 20px;
    color: white;
    z-index: 5;

    h3 {
      font-size: 45px;
      font-family: "Merryweather", sans-serif;
      font-style: italic;
      font-weight: 300;
      border-bottom: 1px solid white;
      line-height: 65px;
      width: fit-content;
    }

    h2 {
      font-size: 55px;
      font-family: var(--article-font);
      font-weight: bold;
      line-height: 65px;
      width: 60%;
    }
  }

</style>


<script is:inline>
  if (!window.__carousel_initialized__) {
    window.__carousel_initialized__ = true;

    window.resizeObserver = new ResizeObserver(() => {
      const carousel = document.querySelector(".carousel");
      if (carousel) {
        carouselWidth = carousel.clientWidth;
        moveCarousel(0); // Réajuste la position
      }
    });

    document.addEventListener("astro:page-load", setupCarousel);
    document.addEventListener("astro:after-swap", setupCarousel);
  }

  let carouselWidth = 0;

  function moveCarousel(direction) {
    const carouselInner = document.querySelector(".carousel-inner");
    const items = document.querySelectorAll(".carousel-inner .carousel-element");

    const totalThematics = items.length;
    if (!carouselInner || totalThematics === 0) return;

    window.currentIndex = (window.currentIndex + direction + totalThematics) % totalThematics;

    if (carouselWidth === 0) {
      const carousel = document.querySelector(".carousel");
      if (carousel) {
        carouselWidth = carousel.clientWidth;
      }
    }

    carouselInner.style.transition = "transform 0.5s ease-in-out";
    carouselInner.style.transform = `translateX(-${window.currentIndex * carouselWidth}px)`;

    updateIndicators();
  }

  function updateIndicators() {
    const indicators = document.querySelectorAll(".index .index-pos");

    indicators.forEach((indicator, index) => {
      indicator.classList.toggle("checked", index === window.currentIndex);
    });

    updateMediaDisplay();
  }

  function updateMediaDisplay() {
    const allGalleries = document.querySelectorAll(".gallery");

    allGalleries.forEach(gallery => {
      gallery.style.display = "none";
    });

    const activeGallery = document.querySelector(`.gallery[data-gallery-index="${window.currentIndex}"]`);
    if (activeGallery) {
      activeGallery.style.display = "block";
    }
  }

  function initializeCarousel() {
    const carouselInner = document.querySelector(".carousel-inner");
    const indicators = document.querySelectorAll(".index .index-pos");
    const thematics = document.querySelectorAll(".carousel-inner .carousel-element");
    const carousel = document.querySelector(".carousel");

    if (!carouselInner || thematics.length === 0 || !carousel) return;

    carouselWidth = carousel.clientWidth;

    carouselInner.style.transition = "none";
    carouselInner.style.transform = `translateX(${window.currentIndex * -carouselWidth}px)`;

    indicators.forEach(indicator => indicator.classList.remove("checked"));
    if (indicators[window.currentIndex]) indicators[window.currentIndex].classList.add("checked");

    updateIndicators();
  }

  function setupCarousel() {
    const carouselElement = document.querySelector(".carousel");
    const selectedIndex = parseInt(carouselElement?.dataset.selectedIndex || "0", 10);
    window.currentIndex = selectedIndex;

    initializeCarousel();
    updateMediaDisplay();

    const carousel = document.querySelector(".carousel");
    if (carousel) window.resizeObserver.observe(carousel);
  }
</script>