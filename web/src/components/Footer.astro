---
import {asset} from "../utils/url";
---

<footer class='container'>
    <div class="haut-footer">
        <div class="haut-footer-info-gauche">
<!--            <div class="colonne">
                <h3 class="titre-colonne-footer">Liens internes</h3>
                <a href="#" class="lien-text-footer">Fonds d'archives</a>
            </div>-->
            <div class="colonne">
                <h3 class="titre-colonne-footer">Institutions</h3>
                <a href="https://www.univ-fcomte.fr/" class="lien-text-footer">UMLP</a>
                <a href="https://elliadd.univ-fcomte.fr" class="lien-text-footer">ELLIADD</a>
                <a href="https://fanum.univ-fcomte.fr/fanum/" class="lien-text-footer">FANUM</a>
                <a href="https://mshe.univ-fcomte.fr" class="lien-text-footer">MSHE</a>
            </div>
            <div class="colonne">
                <h3 class="titre-colonne-footer">Informations légales</h3>
                <a href={asset("/annexe/mentions_legales")} class="lien-text-footer">Mentions légales</a>
            </div>
            <div class="colonne">
                <h3 class="titre-colonne-footer">Le projet</h3>
                <a href="{asset("/annexe/presentation_projet")}" class="lien-text-footer">Manifeste éditorial</a>
                <a href="{asset("/annexe/equipe")}" class="lien-text-footer">L'équipe</a>
                <a href="{asset("/annexe/partenaires")}" class="lien-text-footer">Partenaires</a>
            </div>
        </div>
        <div class="haut-footer-mail-droite">
            <a href="mailto:elliadd@univ-fcomte.fr"><img src={asset("/icones/icon-mail.svg")} alt="Email"></a>
        </div>
    </div>
    <div class="trait-separation"></div>
    <div class="bas-footer">
        <div class="bas-footer-gauche">
            <p></p>
        </div>
        <div class="bas-footer-logos-droite">
            <a href="https://www.bourgognefranchecomte.fr"><img src={asset("/icones/logo-rbfc-blanc.png")} alt="Région Bourgogne Franche-Comté"></a>
            <a href="https://elliadd.univ-fcomte.fr"><img src={asset("/icones/LogoElliadd_blanc.png")} alt="ELLIADD"></a>
            <a href="https://mshe.univ-fcomte.fr"><img src={asset("/icones/mshe-logo-blanc.png")} alt="MSHE"></a>
            <a href="https://www.univ-fcomte.fr/"><img src={asset("/icones/LOGO_UMLP_blanc.png")} alt="Université Marie et Louis Pasteur"></a>
        </div>
    </div>
</footer>

<style>
    .container {
        background: var(--bg-color);
        color: white;
        width: 100%;
        padding: 40px 40px 20px 40px;
        box-sizing: border-box;
        overflow: hidden;
    }

    .haut-footer {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .haut-footer-info-gauche {
        display: flex;
        gap: 40px;
        flex-wrap: wrap;
    }

    .colonne {
        display: flex;
        flex-direction: column;
    }

    .titre-colonne-footer {
        font-size: 1em;
        font-weight: bold;
        margin-bottom: 20px;
    }

    .lien-text-footer {
        color: #aaa;
        font-size: 0.9em;
        text-decoration: none;
        margin-bottom: 5px;
    }

    .lien-text-footer:hover {
        color: white;
    }

    .trait-separation {
        width: 100%;
        height: 1px;
        background: #444;
        margin: 20px 0;
    }

    .haut-footer-mail-droite {

    }

    .haut-footer-mail-droite img {
        width: 50px;
    }

    .bas-footer-logos-droite img {
        width: 50px;
        margin: 5px 15px;
    }

    .bas-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
    }

    .bas-footer-gauche p {
        color: #ccc;
    }

    .bas-footer-logos-droite {
        display: flex;
        justify-content: center;
        justify-items: center;
        align-items: center;
    }

    .bas-footer-logos-droite img {
        width: 100px;
        margin-left: 20px;
        align-items: center;
    }
</style>
