---
import BlocMedia from "./BlocMedia.astro";

type Props = {
  medias: {
    type: "image" | "audio";
    src: string;
    slug: string;
    titre: string;
  }[];

  mediasList: []
};

const { medias, mediasList } = Astro.props;
---

<div class="bloc5">
  <div class="row-big">
    <div class="rectangle bleu">
      {medias[0] && <BlocMedia media={medias[0]} mediasList={mediasList} />}
    </div>
  </div>
  <div class="row-2-5-reversed">
    <div class="rectangle orange">
      {medias[1] && <BlocMedia media={medias[1]} mediasList={mediasList} />}
    </div>
    <div class="rectangle rose">
      {medias[2] && <BlocMedia media={medias[2]} mediasList={mediasList} />}
    </div>
  </div>
</div>

<style scoped>
  .bloc5 {
    display: flex;
    flex-direction: column;
    height: 501px;
    width: 100%;
    gap: 4px;

    div {
      gap: 4px;
    }
  }

  .image {
    object-fit: cover;
    width: 100%;
    height: 100%;
    border-radius: 3px;
  }
  .row-2-5-reversed {
    display: flex;
    flex-direction: row;
    height: 227px;
    width: 100%;
    .rectangle:nth-child(1) {
      width: 60%;
    }
    .rectangle:nth-child(2) {
      width: 56%;
    }
  }
  .row-big {
    display: flex;
    flex-direction: row;
    height: 266px;
    width: 100%;

    .rectangle {
      width: 100%;
      border-radius: 3px;
    }
  }
</style>
