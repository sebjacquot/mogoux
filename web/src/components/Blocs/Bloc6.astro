---
import BlocMedia from "./BlocMedia.astro";

type Props = {
  medias: {
    type: "image" | "audio";
    src: string;
    slug: string;
    titre: string;
  }[];

  mediasList: []
};

const { medias, mediasList } = Astro.props;
---

<div class="bloc6">
  <div class="row-1-5-col-right">
    <div class="rectangle bleu">
      {medias[0] && <BlocMedia media={medias[0]} mediasList={mediasList} />}
    </div>
    <div class="col-2-4">
      <div class="rectangle rose">
        {medias[1] && <BlocMedia media={medias[1]} mediasList={mediasList} />}
      </div>
      <div class="rectangle violet">
        {medias[2] && <BlocMedia media={medias[2]} mediasList={mediasList} />}
      </div>
    </div>
  </div>
  <div class="row-3-4-col-right">
    <div class="rectangle orange">
      {medias[3] && <BlocMedia media={medias[3]} mediasList={mediasList} />}
    </div>
    <div class="col-2-5">
      <div class="rectangle rouge">
        {medias[4] && <BlocMedia media={medias[4]} mediasList={mediasList} />}
      </div>
      <div class="rectangle vert">
        {medias[5] && <BlocMedia media={medias[5]} mediasList={mediasList} />}
      </div>
    </div>
  </div>
</div>

<style scoped>
  .bloc6 {
    display: flex;
    flex-direction: column;
    height: 501px;
    width: 100%;
    gap: 4px;

    div {
      gap: 4px;
    }
  }
  .rectangle {
    border-radius: 3px;
  }

  .image {
    object-fit: cover;
    width: 100%;
    height: 100%;
    border-radius: 3px;
  }
  .row-1-5-col-right {
    display: flex;
    flex-direction: row;
    height: 242px;
  }
  .col-2-4 {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 100px;

    .rectangle:nth-child(1) {
      height: 49%;
    }
    .rectangle:nth-child(2) {
      height: 49%;
    }
  }
  .row-3-4-col-right {
    display: flex;
    height: 250px;
  }
  .row-3-4-col-right > .rectangle:nth-child(1) {
    width: 54%;
  }
  .col-2-5 {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 46%;
    height: 100%;

    .rectangle:nth-child(1) {
      width: 100%;
      height: 40%;
    }
    .rectangle:nth-child(2) {
      width: 100%;
      height: 59%;
    }
  }
</style>
