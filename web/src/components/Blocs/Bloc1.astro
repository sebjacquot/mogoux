---
import BlocMedia from "./BlocMedia.astro";

type Props = {
  medias: { type: "image" | "audio"; src: string; slug: string }[];
};

const { medias } = Astro.props;
---

<div class="bloc1">
  <div class="row-large">
    <div class="rectangle">
      {medias[0] && <BlocMedia {...medias[0]} />}
    </div>
  </div>
  <div class="row-3-4">
    <div class="rectangle">
      {medias[1] && <BlocMedia {...medias[1]} />}
    </div>
    <div class="rectangle">
      {medias[2] && <BlocMedia {...medias[2]} />}
    </div>
  </div>
  <div class="row-1-2">
    <div class="rectangle">
      {medias[3] && <BlocMedia {...medias[3]} />}
    </div>
    <div class="rectangle">
      {medias[4] && <BlocMedia {...medias[4]} />}
    </div>
  </div>
</div>

<style scoped>
  .image {
    object-fit: cover;
    width: 100%;
    height: 100%;
    border-radius: 3px;
  }

  .bloc1 {
    display: flex;
    flex-direction: column;
    height: 501px;
    width: 100%;
    gap: 4px;

    div {
      gap: 4px;
    }
  }
  .row-large {
    display: flex;
    flex-direction: row;
    height: 207px;
    width: 100%;

    .rectangle {
      width: 100%;
    }
  }
  .row-3-4 {
    display: flex;
    flex-direction: row;
    height: 177px;
    width: 100%;

    .rectangle:nth-child(1) {
      width: 61.6%;
    }
    .rectangle:nth-child(2) {
      width: 38.4%;
    }
  }
  .row-1-2 {
    display: flex;
    flex-direction: row;
    height: 104px;
    width: 100%;

    .rectangle:nth-child(1) {
      width: 52.5%;
    }
    .rectangle:nth-child(2) {
      width: 47.5%;
    }
  }
  .rectangle {
    height: 100%;
    border-radius: 3px;
  }
</style>
