---
import BlocMedia from "./BlocMedia.astro";

type Props = {
  medias: { type: "image" | "audio"; src: string; slug: string }[];
};

const { medias } = Astro.props;
---

<div class="bloc4">
  <div class="row-3-4-col-right">
    <div class="rectangle orange">
      {medias[0] && <BlocMedia {...medias[0]} />}
    </div>
    <div class="col-2-5">
      <div class="rectangle rouge">
        {medias[1] && <BlocMedia {...medias[1]} />}
      </div>
      <div class="rectangle vert">
        {medias[2] && <BlocMedia {...medias[2]} />}
      </div>
    </div>
  </div>
  <div class="row-1-5-col-right">
    <div class="rectangle bleu">
      {medias[3] && <BlocMedia {...medias[3]} />}
    </div>
    <div class="col-2-4">
      <div class="rectangle rose">
        {medias[4] && <BlocMedia {...medias[4]} />}
      </div>
      <div class="rectangle violet">
        {medias[5] && <BlocMedia {...medias[5]} />}
      </div>
    </div>
  </div>
</div>

<style scoped>
  .bloc4 {
    display: flex;
    flex-direction: column;
    height: 501px;
    width: 100%;
    gap: 4px;

    div {
      gap: 4px;
    }
  }

  .image {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }
  .rectangle {
    height: 100%;
  }
  .col-2-5 {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 46%;
    height: 100%;

    .rectangle:nth-child(1) {
      width: 100%;
      height: 100px;
    }
    .rectangle:nth-child(2) {
      width: 100%;
      height: 150px;
    }
  }
  .row-3-4-col-right {
    display: flex;
    height: 250px;
  }
  .row-3-4-col-right > .rectangle:nth-child(1) {
    width: 54%;
  }
  .row-1-5-col-right {
    display: flex;
    flex-direction: row;
    height: 242px;
    overflow: hidden;
  }
  .row-1-5-col-right > .rectangle:nth-child(1) {
    width: 47.6%;
  }
  .col-2-4 {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 52.5%;
    height: 100%;

    .rectangle:nth-child(1) {
      height: 50%;
    }
    .rectangle:nth-child(2) {
      height: 50%;
    }
  }
</style>
