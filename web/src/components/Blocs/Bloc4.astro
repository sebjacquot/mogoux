---
type Props = {
  src: string[];
};

const { src } = Astro.props;
---

<div class="bloc4">
  <div class="row-3-4-col-right">
    <div class="rectangle orange">
      <img src={src[0]} class="image" loading="lazy" />
    </div>
    <div class="col-2-5">
      <div class="rectangle rouge">
        <img src={src[1]} class="image" loading="lazy" />
      </div>
      <div class="rectangle vert">
        <img src={src[2]} class="image" loading="lazy" />
      </div>
    </div>
  </div>
  <div class="row-1-5-col-right">
    <div class="rectangle bleu">
      <img src={src[3]} class="image" loading="lazy" />
    </div>
    <div class="col-2-4">
      <div class="rectangle rose">
        <img src={src[4]} class="image" loading="lazy" />
      </div>
      <div class="rectangle violet">
        <img src={src[5]} class="image" loading="lazy" />
      </div>
    </div>
  </div>
</div>

<style scoped>
  .bloc4 {
    display: flex;
    flex-direction: column;
    height: 501px;
    width: 100%;
    gap: 4px;

    div {
      gap: 4px;
    }
  }

  .image {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }
  .rectangle {
    height: 100%;
  }
  .col-2-5 {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 46%;
    height: 100%;

    .rectangle:nth-child(1) {
      width: 100%;
      height: 100px;
    }
    .rectangle:nth-child(2) {
      width: 100%;
      height: 150px;
    }
  }
  .row-3-4-col-right {
    display: flex;
    height: 250px;
  }
  .row-3-4-col-right > .rectangle:nth-child(1) {
    width: 54%;
  }
  .row-1-5-col-right {
    display: flex;
    flex-direction: row;
    height: 242px;
    overflow: hidden;
  }
  .row-1-5-col-right > .rectangle:nth-child(1) {
    width: 47.6%;
  }
  .col-2-4 {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 52.5%;
    height: 100%;

    .rectangle:nth-child(1) {
      height: 50%;
    }
    .rectangle:nth-child(2) {
      height: 50%;
    }
  }
</style>
