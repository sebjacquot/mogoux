---
import AudioCard from "../AudioCard.astro";

type Props = {
  type: "image" | "audio" | "video";
  src: string;
  slug: string;
  titre: string;
};

const { type, src, slug, titre } = Astro.props;
---

<a href={`/medias/${slug}`}>
  {
    type === "audio" ? (
      <AudioCard src={src} />
    ) : (
      <img class="image" src={src} loading="lazy" />
    )
  }
  <h3>{titre}</h3>
</a>

<style scoped>
  a,
  .image {
    object-fit: cover;
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 3px;
    position: relative;
  }

  h3 {
    position: absolute;
    bottom: 0;
    left: 0;
    text-align: center;
    width: 100%;

    font-size: 17px;
    color: whitesmoke;
    font-weight: 700;
    font-family: var(--primary-font);
    line-height: 1.1;

    padding-bottom: 10px;

    z-index: 100;

    opacity: 0;
    transition: all 0.5s;
  }
  a:after {
    content: "";
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    z-index: 1;
    border-radius: 3px;
    transition: all 0.3s;
  }
  a:hover:after {
    background-color: rgba(0, 0, 0, 0.6);
    border: 2px solid var(--secondary-color);
  }
  a:hover h3 {
    opacity: 1;
  }
</style>
