---
type Props = {
  src: string[];
};

const { src } = Astro.props;
---

<div class="bloc2">
  <div class="row-2-5">
    <div class="rectangle violet">
      <img src={src[0]} class="image" loading="lazy" />
    </div>
    <div class="rectangle rouge">
      <img src={src[1]} class="image" loading="lazy" />
    </div>
  </div>
  <div class="row-big">
    <div class="rectangle orange">
      <img src={src[2]} class="image" loading="lazy" />
    </div>
  </div>
</div>

<style scoped>
  .image {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  .bloc2 {
    display: flex;
    flex-direction: column;
    height: 501px;
    width: 100%;
    gap: 4px;

    div {
      gap: 4px;
    }
  }

  .row-2-5 {
    display: flex;
    flex-direction: row;
    height: 227px;
    width: 100%;
    .rectangle:nth-child(1) {
      width: 56%;
    }
    .rectangle:nth-child(2) {
      width: 60%;
    }
  }
  .row-big {
    display: flex;
    flex-direction: row;
    height: 266px;
    width: 100%;

    .rectangle {
      width: 100%;
    }
  }

  .bleu {
    background: blue;
  }
  .rouge {
    background: red;
  }
  .vert {
    background: green;
  }
  .violet {
    background: violet;
  }
  .rose {
    background: pink;
  }
  .orange {
    background: orange;
  }
</style>
