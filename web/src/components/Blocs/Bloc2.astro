---
import BlocMedia from "./BlocMedia.astro";

type Props = {
  medias: { type: "image" | "audio"; src: string; slug: string }[];
};

const { medias } = Astro.props;
---

<div class="bloc2">
  <div class="row-2-5">
    <div class="rectangle violet">
      {medias[0] && <BlocMedia {...medias[0]} />}
    </div>
    <div class="rectangle rouge">
      {medias[1] && <BlocMedia {...medias[1]} />}
    </div>
  </div>
  <div class="row-big">
    <div class="rectangle orange">
      {medias[2] && <BlocMedia {...medias[2]} />}
    </div>
  </div>
</div>

<style scoped>
  .image {
    object-fit: cover;
    width: 100%;
    height: 100%;
    border-radius: 3px;
  }

  .bloc2 {
    display: flex;
    flex-direction: column;
    height: 501px;
    width: 100%;
    gap: 4px;

    div {
      gap: 4px;
    }
  }

  .row-2-5 {
    display: flex;
    flex-direction: row;
    height: 227px;
    width: 100%;
    .rectangle:nth-child(1) {
      width: 56%;
    }
    .rectangle:nth-child(2) {
      width: 60%;
    }
  }
  .row-big {
    display: flex;
    flex-direction: row;
    height: 266px;
    width: 100%;

    .rectangle {
      width: 100%;
      border-radius: 3px;
    }
  }
</style>
