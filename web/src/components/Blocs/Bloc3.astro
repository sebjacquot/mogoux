---
type Props = {
  src: string[];
};

const { src } = Astro.props;
---

<div class="bloc3">
  <div class="row-3-4">
    <div class="rectangle bleu">
      <img src={src[0]} class="image" loading="lazy" />
    </div>
    <div class="rectangle rose">
      <img src={src[1]} class="image" loading="lazy" />
    </div>
  </div>
  <div class="row-1-2-reversed">
    <div class="rectangle vert">
      <img src={src[2]} class="image" loading="lazy" />
    </div>
    <div class="rectangle violet"><img src={src[3]} class="image" /></div>
  </div>
  <div class="row-large">
    <div class="rectangle rouge">
      <img src={src[4]} class="image" loading="lazy" />
    </div>
  </div>
</div>

<style scoped>
  .bloc3 {
    display: flex;
    flex-direction: column;
    height: 501px;
    width: 100%;
    gap: 4px;

    div {
      gap: 4px;
    }
  }

  .image {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }
  .row-1-2-reversed {
    display: flex;
    flex-direction: row;
    height: 104px;
    width: 100%;

    .rectangle:nth-child(1) {
      width: 47.5%;
    }
    .rectangle:nth-child(2) {
      width: 52.5%;
    }
  }

  .row-large {
    display: flex;
    flex-direction: row;
    height: 207px;
    width: 100%;

    .rectangle {
      width: 100%;
    }
  }
  .row-3-4 {
    display: flex;
    flex-direction: row;
    height: 177px;
    width: 100%;

    .rectangle:nth-child(1) {
      width: 61.6%;
    }
    .rectangle:nth-child(2) {
      width: 38.4%;
    }
  }
</style>
