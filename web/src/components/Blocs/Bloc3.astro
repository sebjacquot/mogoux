---
import BlocMedia from "./BlocMedia.astro";

type Props = {
  medias: {
    type: "image" | "audio";
    src: string;
    slug: string;
    titre: string;
  }[];

  mediasList: []
};

const { medias, mediasList } = Astro.props;
---

<div class="bloc3">
  <div class="row-3-4">
    <div class="rectangle bleu">
      {medias[0] && <BlocMedia media={medias[0]} mediasList={mediasList} />}
    </div>
    <div class="rectangle rose">
      {medias[1] && <BlocMedia media={medias[1]} mediasList={mediasList} />}
    </div>
  </div>
  <div class="row-1-2-reversed">
    <div class="rectangle vert">
      {medias[2] && <BlocMedia media={medias[2]} mediasList={mediasList} />}
    </div>
    <div class="rectangle violet">
      {medias[3] && <BlocMedia media={medias[3]} mediasList={mediasList} />}
    </div>
  </div>
  <div class="row-large">
    <div class="rectangle rouge">
      {medias[4] && <BlocMedia media={medias[4]} mediasList={mediasList} />}
    </div>
  </div>
</div>

<style scoped>
  .bloc3 {
    display: flex;
    flex-direction: column;
    height: 501px;
    width: 100%;
    gap: 4px;

    div {
      gap: 4px;
    }
  }

  .image {
    object-fit: cover;
    width: 100%;
    height: 100%;
    border-radius: 3px;
  }
  .row-1-2-reversed {
    display: flex;
    flex-direction: row;
    height: 104px;
    width: 100%;

    .rectangle:nth-child(1) {
      width: 47.5%;
    }
    .rectangle:nth-child(2) {
      width: 52.5%;
    }
  }

  .row-large {
    display: flex;
    flex-direction: row;
    height: 207px;
    width: 100%;

    .rectangle {
      width: 100%;
      border-radius: 3px;
    }
  }
  .row-3-4 {
    display: flex;
    flex-direction: row;
    height: 177px;
    width: 100%;

    .rectangle:nth-child(1) {
      width: 61.6%;
    }
    .rectangle:nth-child(2) {
      width: 38.4%;
    }
  }
</style>
