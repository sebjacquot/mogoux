---
import "../styles/global.css";
type Props = {
  src: string;
  alt: string;
  titre: string;
  slug: string;
};

const { src, titre, alt, slug } = Astro.props;
---

<a href={`/thematiques/${slug}`}>
  <div class="card" style="hover h3: color blue">
    <div class="rectangle">
      <img src=`${import.meta.env.CMS_URL}/medias/${src}` alt={alt} />
      <div class="overlay"></div>
    </div>
    <h3 style="color: blue;">{titre}</h3>
  </div>
</a>

<style scoped>
  a {
    text-decoration: none;
    color: inherit;
    /* background: red; */
  }
  a:hover {
    cursor: pointer;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: all 2s ease-in-out;
  }

  .card:hover {
    transition: all 2s ease-in-out;
    h3 {
      color: #ff7979;
    }
    .overlay {
      opacity: 0.502;
    }
  }

  .rectangle {
    height: 250px;
    position: relative;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
    .overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(255, 121, 121, 0.502);
      transition: all 0.2s ease-in-out;
      opacity: 0;
    }
  }

  .card:hover .rectangle .overlay {
    opacity: 0.5;
  }

  h3 {
    font-size: 20px;
    font-weight: 700;
    width: 300px;
    transition: all 0.2s ease-in-out;
  }
</style>
