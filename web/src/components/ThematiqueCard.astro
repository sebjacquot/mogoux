---
import "../styles/global.css";
import {asset} from "../utils/url";

type Props = {
  idThematic: string;
  titre: string;
  slug: string;
  color: string;
  sectionId: string
};

const { idThematic, titre, slug, color, sectionId } = Astro.props;

let thematic = [];
try {
  const res = await fetch(`${import.meta.env.CMS_URL}/api/thematics/${idThematic}`);
  thematic = await res.json();
} catch (error) {
  console.error("Failed to fetch thematic", error);
}

const urlPreveiw = thematic.background_image.sizes?.preview?.url
const altPreveiw = thematic.background_image.alt
---

<a href={asset(`/thematiques/${slug}?section=${sectionId}`)}>
  <div class="card">
    {urlPreveiw.trim() && (
        <img src={`${import.meta.env.CMS_BASE_URL}${urlPreveiw}`} alt={altPreveiw} />
    )}
    <h3 class="titre-thematique">{titre}</h3>
  </div>
</a>

<style scoped define:vars={{color}}>
  a {
    text-decoration: none;
    color: inherit;
  }

  a:hover {
    cursor: pointer;
  }

  .card {
    gap: 16px;
    transition: all 0.3s ease-in-out;
    border-radius: 3px;
    position: relative;
    overflow: hidden;
    height: 250px;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 0.3s ease-in-out;
    }
  }

  .card:hover img {
    transform: scale(1.04);
  }

  .titre-thematique {
    position: absolute;
    bottom: 0;
    left: 0;
    padding: 5px 15px 5px 15px;
    font-size: 1.1em;
    font-weight: 700;
    width: 94%;
    background-color: rgba(119, 110, 110, 0.8);
    transition: background-color 0.3s ease-in-out;
  }

  .card:hover .titre-thematique {
    background-color: color-mix(in srgb, var(--color) 70%, transparent);
  }
</style>