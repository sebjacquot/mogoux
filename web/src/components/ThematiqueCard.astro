---
import "../styles/global.css";
import {asset} from "../utils/url";

type Props = {
  src: string;
  alt: string;
  titre: string;
  slug: string;
  color: string;
  sectionId: string
};

const { src, titre, alt, slug, color, sectionId } = Astro.props;
---

<a href={asset(`/thematiques/${slug}?section=${sectionId}`)}>
  <div class="card">
    <img src={`${import.meta.env.CMS_URL}${src}`} alt={alt} />
    <h3 class="titre-thematique">{titre}</h3>
  </div>
</a>

<style scoped define:vars={{color}}>
  a {
    text-decoration: none;
    color: inherit;
  }

  a:hover {
    cursor: pointer;
  }

  .card {
    gap: 16px;
    transition: all 0.3s ease-in-out;
    border-radius: 3px;
    position: relative;
    overflow: hidden;
    height: 250px;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 0.3s ease-in-out;
    }
  }

  .card:hover img {
    transform: scale(1.04);
  }

  .titre-thematique {
    position: absolute;
    bottom: 0;
    left: 0;
    padding: 5px 15px 5px 15px;
    font-size: 1.1em;
    font-weight: 700;
    width: 94%;
    background-color: rgba(119, 110, 110, 0.8);
    transition: background-color 0.3s ease-in-out;
  }

  .card:hover .titre-thematique {
    background-color: color-mix(in srgb, var(--color) 70%, transparent);
  }
</style>