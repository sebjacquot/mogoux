{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react",
    "paths": {
      "payload/generated-types": ["./src/generated-types.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "src/generated-types.d.ts" // Pour résoudre un probleme d'incompatibilité entre Payload CMS v3 et TypeScript 5.5
  ],
  "ts-node": {
    "transpileOnly": true,
    "swc": true
  }
}
