---
import "../styles/global.css";
import { Image } from "astro:assets";
---

<html>
  <main>
    <section class="carousel">
      <div class="chapitrage">
        <div class="gauche"></div>
        <div class="droite">
          <h3>Episode 1</h3>
          <h2>Where killers go free</h2>
          <p>
            A gruesome video turns up on a cell phone, abandoned in the back of
            a taxi. Four men desperately cling to wreckage, somewhere in the
            high seas. Shots ring out. The men are gunned down, methodically,
            one by one. Over the span of a decade, Ian Urbina will travel the
            oceans in search of answers.
          </p>
          <button>Watch Episode</button>
        </div>
      </div>
    </section>
  </main>

  <style scoped>
    .chapitrage {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;

      gap: 5em;
    }
    .gauche {
      width: 465px;
      height: 700px;
      background-color: blue;

      margin-top: 30px;
    }

    .droite {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      color: #f3f3f3;
      font-family: var(--titres-font);
      max-width: 38em;

      h3 {
        font-size: 16px;
        text-transform: uppercase;
        font-weight: 800;
        letter-spacing: -0.0125em;
        color: #858585;
      }

      h2 {
        text-transform: uppercase;
        font-size: 40px;
        font-weight: 800;
        letter-spacing: -1px;
      }
      p {
        font-size: 19px;
        font-family: var(--article-font);
        line-height: 1.5;
        font-weight: 500;
        padding: 0 20px;

        margin: 1em auto 1.75em;

        text-align: center;
      }

      button {

        position: relative;
        display: inline-block;
        background-color: #CCCCCC1A;
        
        border: none;
        color: var(--secondary-color);
        font-family: var(--titres-font);
        font-weight: 800;
        font-size: 13px;
        line-height: 2.9;
        padding: 0 1.25em;
        border-radius: 0.25em;

        

        transition: opacity: 0.3s;
        box-shadow: rgba(0, 0, 0, 0.5) 0px 0px 0.125em;
      }
      button::after{
        content: "";
        position: absolute;
        inset: 0px 0px 0px 0%;
        box-shadow: #efefef 0px 0px 2px inset;
        border-radius: 0.25em;
        opacity: 0.2;
        transition: opacity 0.2s;
      }

      button:hover::after{
        opacity: 0.5;
      }
      button:hover{
        background-color: #CCCCCC33;
        cursor: pointer;
      }
    }

    * {
      box-sizing: border-box;
    }
    html,
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      background: var(--bg-color);
      position: relative;

      overflow-x: hidden;
    }
  </style>


</html>
