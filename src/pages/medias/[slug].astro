---
import "../../styles/global.css";
import { Image } from "astro:assets";
import Details from "../../components/Details.astro";

const { slug } = Astro.params;

let details = [];
try {
  const res = await fetch("http://localhost:3000/api/medias/");
  const data = await res.json();
  details = data.docs || [];
} catch (error) {
  console.error("Failed to fetch medias details", error);
}
---

<head>
  <meta charset="UTF-8" />
</head>

<html>
  <main>
    {
      details.map((detail) => {
        // Extraire les noms des tags
        const tags = detail.identification.tag.map((tag) => tag.tag_name);

        return (
          <Details
            titre={detail.identification.title}
            date={detail.identification.date}
            description={detail.description}
            lieu_name={detail.location.location_name}
            lieu_link={detail.location.location_link}
            credits_name={detail.contexte.credits_name}
            credits_link={detail.contexte.credits_link}
            tags={tags}
            type={detail.type}
            link_notice={detail.notice}
          />
        );
      })
    }
  </main>
</html>
<style scoped>
  html {
    background: rgba(22, 22, 22, 1);
    color: white;
  }

  main {
    width: 100%;
    height: 100vh;
    background: rgba(22, 22, 22, 0.8);
    overflow: hidden;
  }
  .row {
    display: flex;
    align-items: center;
    padding: 6% 8%;
    gap: 5em;

    height: 80%;
  }
  .texte {
    display: flex;
    flex-direction: column;
    justify-content: center;

    width: 40%;
    height: 100%;

    font-size: 20px;
    font-family: var(--merryweather);

    .titre {
      font-size: 50px;
      line-height: 56px;
      margin-bottom: 6px;
      font-family: var(--merryweather);
      font-weight: 700;

      margin-top: 50px;
    }
    .description {
      margin-bottom: 1.5em;
      width: 90%;
    }
    .liste {
      margin-bottom: 1em;
      list-style: none;

      li {
        margin: -0px 0;
      }
    }
    .date {
      background: #3c4e77;

      width: fit-content;
      padding: 5px 10px;
      border-radius: 10px;
      margin: 0 0 10px 0;
      font-family: var(--merryweather);
      font-size: 17px;
    }
    .datas {
      display: flex;
      justify-content: flex-start;
      margin-top: auto;
      margin-bottom: 10px;
      .gauche {
        margin-right: 50px;
        font-weight: bold;
        font-size: 21px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
      }
      .droite {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
      }
    }
  }
  .rectangle-image {
    width: 1200px;
    height: 650px;
    background-color: rgba(0, 0, 255, 0.4);

    position: relative;

    .carre {
      width: 50px;
      height: 50px;
      background-color: red;

      position: absolute;
      top: 20px;
      right: 20px;
    }
  }

  a {
    color: white;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
</style>
