---
import Carrousel from "../components/Carrousel.astro";

const { src, titre, alt, slug, couleur } = Astro.props;

let carousel = [];
try {
  const res = await fetch("http://localhost:3000/api/cities/");
  const data = await res.json();
  carousel = data;
  console.log("Carousel Data:", carousel); // Ajout d'une console pour vérifier les données récupérées
} catch (error) {
  console.error("Failed to fetch cities", error);
}

const srcs = carousel.flatMap((item) =>
  item.thematics.map((thematic) => thematic.backgroundImage.filename)
);
const titres = carousel.flatMap((item) =>
  item.thematics.map((thematic) => thematic.title)
);
const slugs = carousel.flatMap((item) =>
  item.thematics.map((thematic) => thematic.slug)
);
const couleurs = carousel.flatMap((item) =>
  item.thematics.map((thematic) => thematic.color)
);

console.log("Couleurs:", couleurs);

console.log("Srcs:", srcs);
console.log("Titres:", titres);
console.log("Slug:", slugs);
console.log("Couleur:", couleurs);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{alt}</title>
  </head>
  <body>
    <Carrousel src={srcs} titre={titres} slug={slugs} couleur={couleurs} />
  </body>
</html>

<style scoped>
  body {
    font-family: Arial, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0;
    background-color: #f0f0f0;
  }
</style>
