---
import "../styles/global.css";
import { Image } from "astro:assets";
---

<head>
  <meta charset="UTF-8" />
</head>

<html>
  <main>
    <div class="rectangle"></div>
    <section class="entete">
      <div class="hero">
        <h2 class="tag">Dossiers</h2>
        <h1 class="titre">Ken Loach à Angers</h1>
        <h2 class="soustitre">Saine colère</h2>
        <div class="intro">
          <p>
            Le <strong>Festival Premiers Plans d’Angers</strong>, pour sa 36e
            édition du 20 au 28 janvier, lui consacre une rétrospective de
            quinze films sur les vingt-sept réalisés pour le cinéma. Ken Loach,
            c’est un regard humaniste, une saine colère. Un cinéma aussi engagé
            que poétique et salutaire. Florilège amoureux des préférés des
            Bandapartistes.
          </p>
          <div class="separation">
            <div class="background">
              <h3 class="date">Le 18 Jan 2024 à 07:30</h3>
            </div>
          </div>
        </div>
      </div>
      <img
        class="img-cover"
        src="/images/GOU_A_08_04_083.png"
        alt="Ken Loach"
      />
      <div class="overlay"></div>
    </section>
  </main>
</html>

<style scoped>
  * {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background: white;
    position: relative;

    /* overflow: hidden; */
  }
  strong {
    font-weight: bold;
  }

  .separation {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    background: white;
    margin-top: 20px;

    h3 {
      font-size: 11px;
    }

    .background {
      padding: 0 10px;
      background: white;
      z-index: 3;
    }
  }
  .background {
    padding: 0 10px;
    background: white;
  }
  .separation::after {
    content: " ";
    border-bottom: 1px solid #d9d9d9;
    display: block;
    width: 100%;
    position: absolute;
    top: 10px;
    z-index: 0;
  }
  .intro {
    background: white;
    width: 100%;
    max-width: 75em;
    height: 156px;
    margin-bottom: 0;
    margin-top: 80px;
    padding: 20px 40px 0px 40px;
    /* padding: 100px; */

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-content: center;

    p {
      font-family: "Times New Roman", Times, serif;
      font-style: italic;
      font-size: 1.063rem /*  17px */;
      text-align: center;
      align-self: center;
    }
  }
  .entete {
    position: relative;
    width: 100%;
    height: 75vh;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }
  .rectangle {
    background: #242424;
    width: 100vw;
    height: 80px;
  }
  .img-cover {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 75vh;
    object-fit: cover;
    z-index: 1;
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 75vh;
    background: rgba(0, 0, 0, 0.3);
    z-index: 1;
  }
  main {
    position: relative;
    width: 100%;

    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero {
    background-image: url("img/kenloach.jpg");
    font-family: "Graphik", sans-serif;
    height: 75vh;
    /* margin-top: 150px; */
    z-index: 100;

    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;

    .tag {
      font-weight: bold;
      color: white;
      font-size: 12px !important;
      line-height: 19.2px;
      text-transform: uppercase;
      padding: 1px 10px 1px 10px;
      border-radius: 4px;
      margin-bottom: 30px;

      background-color: #009587;
    }

    .titre {
      font-weight: bold;
      color: white;
      font-size: 60px !important;
      line-height: 60px !important;
      /* margin-bottom: 5px; */
    }
    .soustitre {
      font-weight: bold;
      color: white;
      font-size: 30px !important;
      font-weight: 300;
    }
    .soustitre::before {
      content: "";
      display: block;
      border-left: 1px solid #d9d9d9;
      height: 50px;
      width: 1px;
      margin: 20px auto 5px auto;
    }
  }
</style>
