---
import "../styles/global.css";
import { Image } from "astro:assets";
type Props = {
  src: string[];
  alt: string[];
  titre: string[];
};

const { src, titre, alt } = Astro.props;

let carousel = [];
try {
  const res = await fetch("http://localhost:3000/api/cities/");
  const data = await res.json();
  carousel = data.docs || [];
} catch (error) {
  console.error("Failed to fetch cities", error);
}
---

<body>
  <div class="carousel">
    <div class="index">
      {/* Map over the number of carousel-elements */}
      {
        src && src.length > 0 ? (
          src.map((_, index) => <div class="index-pos" key={index} />)
        ) : (
          <p>No images available</p>
        )
      }
    </div>
    <div class="buttons">
      <button class="prev" onclick="moveCarousel(-1)">&#10094;</button>
      <button class="next" onclick="moveCarousel(1)">&#10095;</button>
    </div>
    <div class="carousel-inner">
      {
        src && src.length > 0 ? ( // Check if src array is not empty
          src.map((imageSrc, index) => (
            <div class="carousel-element" key={index}>
              <img class="image" src={imageSrc} alt={alt && alt[index]} />{" "}
              {/* Check if alt array exists */}
              <div class="texte">
                <h3>Thématique</h3>
                <h2 class="titre">{titre && titre[index]}</h2>{" "}
                {/* Check if titre array exists */}
              </div>
            </div>
          ))
        ) : (
          <p>No images available</p>
        )
      }
    </div>
  </div>
</body>
<script lang="scripts.js">
  let currentIndex = 0;

  function moveCarousel(direction) {
    const carouselInner = document.querySelector(".carousel-inner");
    const totalImages = document.querySelectorAll(
      ".carousel-inner .carousel-element"
    ).length;
    const carouselWidth = document.querySelector(".carousel").clientWidth;

    currentIndex += direction;

    if (currentIndex < 0) {
      currentIndex = totalImages - 1;
    } else if (currentIndex >= totalImages) {
      currentIndex = 0;
    }

    carouselInner.style.transform = `translateX(-${
      currentIndex * carouselWidth
    }px)`;

    updateIndicators();
  }

  function updateIndicators() {
    const indicators = document.querySelectorAll(".index .index-pos");
    indicators.forEach((indicator, index) => {
      if (index === currentIndex) {
        indicator.classList.add("checked");
      } else {
        indicator.classList.remove("checked");
      }
    });
  }

  // Initialize the indicators on page load
  document.addEventListener("DOMContentLoaded", updateIndicators);
</script>

<style scoped>
  .carousel {
    background: rgba(0, 0, 255, 0.8);
    width: 100%;
    height: 80vh;
    max-height: 700px;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  .carousel-inner {
    display: flex;
    transition: transform 0.5s ease-in-out;
    height: 100%;
  }

  .carousel-element {
    position: relative;
    width: 100%;
    flex: 0 0 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
  }

  .image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: relative;
  }

  .carousel-element::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 2;
  }

  .buttons {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: absolute;
    top: 50%;
    width: 100%;
    transform: translateY(-50%);
    z-index: 10;
  }

  .buttons button {
    border: none;
    outline: none;
    width: 30px;
    height: 110px;
    background: var(--primary-color);
    color: white;
    transition: all 0.2s ease-in;
  }

  .buttons button:nth-child(2) {
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
  }

  .buttons button:nth-child(1) {
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
  }

  .buttons button:hover {
    background: var(--secondary-color);
    width: 35px;
    color: black;
    cursor: pointer;
  }

  .index {
    display: flex;
    justify-content: center;
    align-items: center;
    position: absolute;
    top: 20px;
    left: 30px;
    gap: 20px;
    z-index: 10;
  }

  .index-pos {
    width: 110px;
    height: 5px;
    border-radius: 5px;
    background-color: white;
  }

  .checked {
    background-color: blueviolet;
  }

  .texte {
    display: flex;
    flex-direction: column;
    padding: 0 0 100px 100px;
    width: fit-content;

    position: absolute;
    bottom: 0;
    left: 0;

    gap: 20px;

    color: white;
    z-index: 5;

    h3 {
      font-size: 50px;
      font-family: "Merryweather", sans-serif;
      font-style: italic;
      font-weight: 300;
      border-bottom: 1px solid white;
      line-height: 65px;
      width: fit-content;
    }

    h2 {
      font-size: 60px;
      font-family: var(--article-font);
      font-weight: bold;
      line-height: 65px;
      width: 60%;
    }
  }
</style>
