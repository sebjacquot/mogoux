# ============================================================
#  .env.example – Webdocumentaire Mémoires Ouvrières
#  Copiez ce fichier en .env et renseignez les valeurs.
#  Ne commitez JAMAIS votre .env dans Git.
# ============================================================

# --- Base de données PostgreSQL ---
# Format : postgres://<user>:<password>@<host>:<port>/<database>
# L'utilisateur par défaut du dump est "fanum", base "mogoux"
DATABASE_URI=postgres://fanum:fanum@127.0.0.1:5432/mogoux

# --- Secret PayloadCMS ---
# Chaîne aléatoire longue (min. 32 caractères) utilisée pour signer les JWT.
# Générez-en une : openssl rand -base64 32
PAYLOAD_SECRET=CHANGEZ_MOI_secret_tres_long_et_aleatoire

# --- URL du serveur (pour les médias Payload) ---
# En développement : http://localhost:3000
# En production : https://votre-domaine.fr (sans slash final)
# Utilisée pour construire les URL des médias uploadés dans PayloadCMS.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Chemin de base (si le site est déployé dans un sous-répertoire) ---
# Exemple : /mogoux  si l'URL est https://example.com/mogoux
# Laissez vide si le site est à la racine du domaine.
NEXT_PUBLIC_BASE_PATH=

# --- Port du serveur Next.js (optionnel, défaut : 3000) ---
PORT=3000
